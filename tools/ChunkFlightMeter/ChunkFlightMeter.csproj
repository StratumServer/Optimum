<Project Sdk="Microsoft.NET.Sdk">
  <!-- Frame meter loaded as a plain client mod in both benchmark arms (vanilla and Optimum), so the
       two are measured with the same instrument. Build with VINTAGE_STORY set to the client directory. -->
  <PropertyGroup>
    <TargetFramework>$(FrameworkVersion)</TargetFramework>
    <AssemblyName>ChunkFlightMeter</AssemblyName>
    <RootNamespace>ChunkFlightMeter</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VINTAGE_STORY)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="modinfo.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
