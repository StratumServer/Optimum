+		/// <summary>Builds a cairo_path_t-compatible block (header plus data array) from managed path elements.</summary>
+		internal static unsafe Path FromElements (ManagedGraphicsState.PathElement[] elements)
+		{
+			int dataCount = 0;
+			foreach (var element in elements)
+				dataCount += element.Op == ManagedGraphicsState.PathOp.ClosePath ? 1 : element.Op == ManagedGraphicsState.PathOp.CurveTo ? 4 : 2;
+			const int headerSize = 32;
+			IntPtr block = (IntPtr)NativeMemory.AllocZeroed ((nuint)(headerSize + dataCount * 16));
+			Marshal.WriteInt32 (block, 0, (int)Status.Success);
+			Marshal.WriteIntPtr (block, 8, IntPtr.Add (block, headerSize));
+			Marshal.WriteInt32 (block, 16, dataCount);
+			int index = 0;
+			foreach (var element in elements) {
+				IntPtr slot = IntPtr.Add (block, headerSize + index * 16);
+				int length = element.Op == ManagedGraphicsState.PathOp.ClosePath ? 1 : element.Op == ManagedGraphicsState.PathOp.CurveTo ? 4 : 2;
+				Marshal.WriteInt32 (slot, 0, (int)element.Op);
+				Marshal.WriteInt32 (slot, 4, length);
+				if (length >= 2) WritePoint (slot, 1, element.X1, element.Y1);
+				if (length >= 4) { WritePoint (slot, 2, element.X2, element.Y2); WritePoint (slot, 3, element.X3, element.Y3); }
+				index += length;
+			}
+			return new Path (block) { ownsManagedMemory = true };
+		}
+
+		static void WritePoint (IntPtr slot, int number, double x, double y)
+		{
+			Marshal.WriteInt64 (slot, number * 16, BitConverter.DoubleToInt64Bits (x));
+			Marshal.WriteInt64 (slot, number * 16 + 8, BitConverter.DoubleToInt64Bits (y));
+		}
+
 		~Path ()
 		{
 			Dispose (false);
 		}
 
