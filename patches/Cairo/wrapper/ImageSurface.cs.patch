+
+	internal void Retain ()	{
+		int current = Volatile.Read (ref references);
+		while (current > 0) {
+			int observed = Interlocked.CompareExchange (ref references, current + 1, current);
+			if (observed == current) return;
+			current = observed;
+		}
+		throw new ObjectDisposedException (nameof (ManagedImageSurfaceStorage));
+	}
+	internal void ReleaseUnattachedPin () { if (Interlocked.Decrement (ref references) == 0 && Handle == IntPtr.Zero) ReleasePixelPin (); }
+
+	void ReleasePixelPin ()
+	{
+		if (Interlocked.Exchange (ref released, 1) != 0) return;
+		dataPointer = IntPtr.Zero;
+		if (pixelPin.IsAllocated) pixelPin.Free ();
+	}
+
+	static void ReleaseFromNative (IntPtr userData)
+	{
