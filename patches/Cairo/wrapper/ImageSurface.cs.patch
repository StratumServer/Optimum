+	internal byte[] CopyPixels ()
+	{
+		int length = checked (Stride * Height);
+		var copy = new byte[length];
+		if (length != 0) {
+			if (pixels != null) Buffer.BlockCopy (pixels, 0, copy, 0, length);
+			else if (externalPixels != IntPtr.Zero) Marshal.Copy (externalPixels, copy, 0, length);
+		}
