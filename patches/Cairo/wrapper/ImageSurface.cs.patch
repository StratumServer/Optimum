+namespace Cairo {
+
+/// <summary>
+/// Owns the pixel array behind a Cairo image surface. The pin is attached to
+/// the native surface with cairo_surface_set_user_data, so aliases may outlive
+/// the ImageSurface wrapper without leaving Cairo with a movable data pointer.
+/// </summary>
+internal sealed class ManagedImageSurfaceStorage
+{
+	static readonly IntPtr userDataKey = Marshal.AllocHGlobal (1);
+	static readonly CairoDestroyFunc destroyCallback = ReleaseFromNative;
+
+	readonly byte[] pixels;
+	GCHandle pixelPin;
+	IntPtr dataPointer;
+	int released;
+
+	internal IntPtr Handle { get; private set; }
+	internal Format Format { get; }
+	internal int Width { get; }
+	internal int Height { get; }
+	internal int Stride { get; }
+		internal IntPtr DataPointer { get { EnsurePixelPin (); return dataPointer; } }
+	internal bool HasManagedPixels => pixels != null;
+
+	ManagedImageSurfaceStorage (Format format, int width, int height, int stride, byte[] pixels)
+	{
+		Format = format;
+		Width = width;
+		Height = height;
+		Stride = stride;
+		this.pixels = pixels;
+	}
+
+	internal static ManagedImageSurfaceStorage Create (Format format, int width, int height)
+	{
+		int stride = Surface.StrideForWidth (format, width);
+		long byteCount = (long)stride * height;
+		if (width < 0 || height < 0 || stride < 0 || byteCount < 0 || byteCount > int.MaxValue)
+			return CreateNative (format, width, height, stride);
+
+		// Keep a non-empty pinned array for zero-area surfaces because Cairo's
+		// create-for-data entry point requires a stable non-null address.
+		var pixels = new byte[Math.Max (1, (int)byteCount)];
+		var storage = new ManagedImageSurfaceStorage (format, width, height, stride, pixels);
+		storage.EnsurePixelPin ();
+		return storage.AttachNativeSurface ();
+	}
+
+	internal static ManagedImageSurfaceStorage CreateManaged (Format format, int width, int height)
+	{
+		int stride = Surface.StrideForWidth (format, width);
+		long byteCount = (long)stride * height;
+		if (width < 0 || height < 0 || stride < 0 || byteCount < 0 || byteCount > int.MaxValue)
+			throw new ArgumentOutOfRangeException (nameof (width), "The managed recording surface dimensions are invalid.");
+		return new ManagedImageSurfaceStorage (format, width, height, stride, new byte[Math.Max (1, (int)byteCount)]);
+	}
+
+	internal IntPtr EnsureNativeSurface ()
+	{
+		if (Handle != IntPtr.Zero) return Handle;
+		return AttachNativeSurface ().Handle;
+	}
+
+	ManagedImageSurfaceStorage AttachNativeSurface ()
+	{
+		EnsurePixelPin ();
+
+		IntPtr surface = IntPtr.Zero;
+		GCHandle storageHandle = default (GCHandle);
+		bool attached = false;
+		try {
+			surface = NativeMethods.cairo_image_surface_create_for_data (dataPointer, Format, Width, Height, Stride);
+			if (surface == IntPtr.Zero) throw new InvalidOperationException ("Cairo returned a null image surface.");
+
+			storageHandle = GCHandle.Alloc (this);
+			Status status = NativeMethods.cairo_surface_set_user_data (surface, userDataKey,
+				GCHandle.ToIntPtr (storageHandle), destroyCallback);
+			if (status != Status.Success)
+				throw new InvalidOperationException ("Could not attach the managed image buffer to its Cairo surface: " + status + ".");
+
+			attached = true;
+			Handle = surface;
+			return this;
+		} catch {
+			if (storageHandle.IsAllocated && !attached) storageHandle.Free ();
+			if (surface != IntPtr.Zero) NativeMethods.cairo_surface_destroy (surface);
+			if (!attached) ReleasePixelPin ();
+			throw;
+		}
+	}
+
+	static ManagedImageSurfaceStorage CreateNative (Format format, int width, int height, int stride)
+	{
+		var storage = new ManagedImageSurfaceStorage (format, width, height, stride, null);
+		storage.Handle = NativeMethods.cairo_image_surface_create (format, width, height);
+		return storage;
+	}
+
+	internal byte[] CopyPixels ()
+	{
+		int length = checked (Stride * Height);
+		var copy = new byte[length];
+		if (length != 0) Buffer.BlockCopy (pixels, 0, copy, 0, length);
+		return copy;
+	}
+
+	void EnsurePixelPin ()
+	{
+		if (dataPointer != IntPtr.Zero) return;
+		if (released != 0) throw new ObjectDisposedException (nameof (ManagedImageSurfaceStorage));
+		pixelPin = GCHandle.Alloc (pixels, GCHandleType.Pinned);
+		dataPointer = pixelPin.AddrOfPinnedObject ();
+	}
+
+	internal void ReleaseUnattachedPin () { if (Handle == IntPtr.Zero) ReleasePixelPin (); }
+
+	void ReleasePixelPin ()
+	{
+		if (Interlocked.Exchange (ref released, 1) != 0) return;
+		dataPointer = IntPtr.Zero;
+		if (pixelPin.IsAllocated) pixelPin.Free ();
+	}
+
+	static void ReleaseFromNative (IntPtr userData)
+	{
+		try {
+			GCHandle handle = GCHandle.FromIntPtr (userData);
+			try { (handle.Target as ManagedImageSurfaceStorage)?.ReleasePixelPin (); }
+			finally { if (handle.IsAllocated) handle.Free (); }
+		} catch {
+			// A native destroy callback must not allow a managed exception to cross the ABI.
+		}
 	}
 }
+
+}
