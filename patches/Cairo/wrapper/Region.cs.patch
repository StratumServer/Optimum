+			var valid = new List<RegionBox> (length);
+			for (int i = 0; i < length; i++) {
+				var box = new RegionBox {
+					X1 = rects[i].X,
+					Y1 = rects[i].Y,
+					X2 = unchecked (rects[i].X + rects[i].Width),
+					Y2 = unchecked (rects[i].Y + rects[i].Height)
