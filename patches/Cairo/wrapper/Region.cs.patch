+			do {
+				int x1 = Math.Max (r1[i1].X1, r2[i2].X1);
+				int x2 = Math.Min (r1[i1].X2, r2[i2].X2);
+				if (x1 < x2)
+					region.Add (new RegionBox { X1 = x1, Y1 = y1, X2 = x2, Y2 = y2 });
+				if (r1[i1].X2 == x2)
+					i1++;
+				if (r2[i2].X2 == x2)
+					i2++;
+			} while (i1 != r1End && i2 != r2End);
+		}
+
+		static void UnionBand (List<RegionBox> region, RegionBox[] r1, int i1, int r1End, RegionBox[] r2, int i2, int r2End, int y1, int y2)
+		{
+			int x1, x2;
+			if (r1[i1].X1 < r2[i2].X1) {
+				x1 = r1[i1].X1;
+				x2 = r1[i1].X2;
+				i1++;
+			} else {
+				x1 = r2[i2].X1;
+				x2 = r2[i2].X2;
+				i2++;
+			}
+
+			while (i1 != r1End && i2 != r2End) {
+				if (r1[i1].X1 < r2[i2].X1)
+					MergeRect (region, r1[i1++], y1, y2, ref x1, ref x2);
+				else
+					MergeRect (region, r2[i2++], y1, y2, ref x1, ref x2);
+			}
+			while (i1 != r1End)
+				MergeRect (region, r1[i1++], y1, y2, ref x1, ref x2);
+			while (i2 != r2End)
+				MergeRect (region, r2[i2++], y1, y2, ref x1, ref x2);
+
+			region.Add (new RegionBox { X1 = x1, Y1 = y1, X2 = x2, Y2 = y2 });
+		}
+
+		static void MergeRect (List<RegionBox> region, RegionBox r, int y1, int y2, ref int x1, ref int x2)
+		{
+			if (r.X1 <= x2) {
+				if (x2 < r.X2)
+					x2 = r.X2;
+			} else {
+				region.Add (new RegionBox { X1 = x1, Y1 = y1, X2 = x2, Y2 = y2 });
+				x1 = r.X1;
+				x2 = r.X2;
+			}
+		}
+
+		static void SubtractBand (List<RegionBox> region, RegionBox[] r1, int i1, int r1End, RegionBox[] r2, int i2, int r2End, int y1, int y2)
+		{
+			int x1 = r1[i1].X1;
+			do {
+				if (r2[i2].X2 <= x1) {
+					i2++;
+				} else if (r2[i2].X1 <= x1) {
+					x1 = r2[i2].X2;
+					if (x1 >= r1[i1].X2) {
+						i1++;
+						if (i1 != r1End)
+							x1 = r1[i1].X1;
+					} else {
+						i2++;
+					}
+				} else if (r2[i2].X1 < r1[i1].X2) {
+					region.Add (new RegionBox { X1 = x1, Y1 = y1, X2 = r2[i2].X1, Y2 = y2 });
+					x1 = r2[i2].X2;
+					if (x1 >= r1[i1].X2) {
+						i1++;
+						if (i1 != r1End)
+							x1 = r1[i1].X1;
+					} else {
+						i2++;
+					}
+				} else {
+					if (r1[i1].X2 > x1)
+						region.Add (new RegionBox { X1 = x1, Y1 = y1, X2 = r1[i1].X2, Y2 = y2 });
+					i1++;
+					if (i1 != r1End)
+						x1 = r1[i1].X1;
+				}
+			} while (i1 != r1End && i2 != r2End);
+
+			while (i1 != r1End) {
+				region.Add (new RegionBox { X1 = x1, Y1 = y1, X2 = r1[i1].X2, Y2 = y2 });
+				i1++;
+				if (i1 != r1End)
+					x1 = r1[i1].X1;
+			}
+		}
+
+		static void AppendBand (List<RegionBox> region, RegionBox[] r, int start, int end, int y1, int y2)
+		{
+			for (int i = start; i < end; i++)
+				region.Add (new RegionBox { X1 = r[i].X1, Y1 = y1, X2 = r[i].X2, Y2 = y2 });
+		}
+
+		// Merges the band starting at curStart into the one starting at prevStart when both hold the same x spans
+		// and touch vertically (pixman_coalesce); returns the start of the band that is now the previous one.
+		static int Coalesce (List<RegionBox> region, int prevStart, int curStart)
+		{
+			int bandCount = curStart - prevStart;
+			if (bandCount != region.Count - curStart)
+				return curStart;
+			if (bandCount == 0)
+				return curStart;
+			if (region[prevStart].Y2 != region[curStart].Y1)
+				return curStart;
+
+			int y2 = region[curStart].Y2;
+			for (int i = 0; i < bandCount; i++) {
+				if (region[prevStart + i].X1 != region[curStart + i].X1 || region[prevStart + i].X2 != region[curStart + i].X2)
+					return curStart;
+			}
+
+			region.RemoveRange (curStart, bandCount);
+			for (int i = 0; i < bandCount; i++) {
+				var box = region[prevStart + i];
+				box.Y2 = y2;
+				region[prevStart + i] = box;
+			}
+			return prevStart;
+		}
+
+		static int BandEnd (RegionBox[] r, int start, int end)
+		{
+			int y1 = r[start].Y1;
+			int bandEnd = start + 1;
+			while (bandEnd != end && r[bandEnd].Y1 == y1)
+				bandEnd++;
+			return bandEnd;
+		}
+
+		// pixman_op: walks both band lists, calls overlap for the shared y ranges and optionally appends the bands
+		// that belong to one operand only. Neither operand is modified, so dst may alias either one.
+		static void Op (RegionGeometry dst, RegionGeometry reg1, RegionGeometry reg2, OverlapProc overlap, bool appendNon1, bool appendNon2)
+		{
+			RegionBox[] a = reg1.boxes;
+			RegionBox[] b = reg2.boxes;
+			int r1 = 0, r1End = reg1.count;
+			int r2 = 0, r2End = reg2.count;
+			var result = new List<RegionBox> (Math.Max (r1End, r2End) * 2);
+			int ybot = Math.Min (a[0].Y1, b[0].Y1);
+			int prevBand = 0;
+			int curBand;
+			int r1BandEnd, r2BandEnd;
+
+			do {
+				r1BandEnd = BandEnd (a, r1, r1End);
+				r2BandEnd = BandEnd (b, r2, r2End);
+				int r1y1 = a[r1].Y1;
+				int r2y1 = b[r2].Y1;
+				int ytop;
+
+				if (r1y1 < r2y1) {
+					if (appendNon1) {
+						int top = Math.Max (r1y1, ybot);
+						int bot = Math.Min (a[r1].Y2, r2y1);
+						if (top != bot) {
+							curBand = result.Count;
+							AppendBand (result, a, r1, r1BandEnd, top, bot);
+							prevBand = Coalesce (result, prevBand, curBand);
+						}
+					}
+					ytop = r2y1;
+				} else if (r2y1 < r1y1) {
+					if (appendNon2) {
+						int top = Math.Max (r2y1, ybot);
+						int bot = Math.Min (b[r2].Y2, r1y1);
+						if (top != bot) {
+							curBand = result.Count;
+							AppendBand (result, b, r2, r2BandEnd, top, bot);
+							prevBand = Coalesce (result, prevBand, curBand);
+						}
+					}
+					ytop = r1y1;
+				} else {
+					ytop = r1y1;
+				}
+
+				ybot = Math.Min (a[r1].Y2, b[r2].Y2);
+				if (ybot > ytop) {
+					curBand = result.Count;
+					overlap (result, a, r1, r1BandEnd, b, r2, r2BandEnd, ytop, ybot);
+					prevBand = Coalesce (result, prevBand, curBand);
+				}
+
+				if (a[r1].Y2 == ybot)
+					r1 = r1BandEnd;
+				if (b[r2].Y2 == ybot)
+					r2 = r2BandEnd;
+			} while (r1 != r1End && r2 != r2End);
+
+			if (r1 != r1End && appendNon1) {
+				r1BandEnd = BandEnd (a, r1, r1End);
+				curBand = result.Count;
+				AppendBand (result, a, r1, r1BandEnd, Math.Max (a[r1].Y1, ybot), a[r1].Y2);
+				prevBand = Coalesce (result, prevBand, curBand);
+				for (int i = r1BandEnd; i < r1End; i++)
+					result.Add (a[i]);
+			} else if (r2 != r2End && appendNon2) {
+				r2BandEnd = BandEnd (b, r2, r2End);
+				curBand = result.Count;
+				AppendBand (result, b, r2, r2BandEnd, Math.Max (b[r2].Y1, ybot), b[r2].Y2);
+				prevBand = Coalesce (result, prevBand, curBand);
+				for (int i = r2BandEnd; i < r2End; i++)
+					result.Add (b[i]);
+			}
+
+			dst.boxes = result.ToArray ();
+			dst.count = result.Count;
+			if (dst.count == 1)
+				dst.extents = dst.boxes[0];
+		}
+
+		// pixman_region32_intersect
+		internal static void Intersect (RegionGeometry dst, RegionGeometry reg1, RegionGeometry reg2)
+		{
+			if (reg1.count == 0 || reg2.count == 0 || !ExtentCheck (reg1.extents, reg2.extents)) {
+				dst.extents.X2 = dst.extents.X1;
+				dst.extents.Y2 = dst.extents.Y1;
+				dst.SetEmpty ();
+			} else if (reg1.count == 1 && reg2.count == 1) {
+				dst.SetSingle (new RegionBox {
+					X1 = Math.Max (reg1.extents.X1, reg2.extents.X1),
+					Y1 = Math.Max (reg1.extents.Y1, reg2.extents.Y1),
+					X2 = Math.Min (reg1.extents.X2, reg2.extents.X2),
+					Y2 = Math.Min (reg1.extents.Y2, reg2.extents.Y2)
+				});
+			} else if (reg2.count == 1 && Subsumes (reg2.extents, reg1.extents)) {
+				Copy (dst, reg1);
+			} else if (reg1.count == 1 && Subsumes (reg1.extents, reg2.extents)) {
+				Copy (dst, reg2);
+			} else if (ReferenceEquals (reg1, reg2)) {
+				Copy (dst, reg1);
+			} else {
+				Op (dst, reg1, reg2, IntersectBand, false, false);
+				SetExtents (dst);
+			}
+		}
+
+		// pixman_region32_union
+		internal static void Union (RegionGeometry dst, RegionGeometry reg1, RegionGeometry reg2)
+		{
+			if (ReferenceEquals (reg1, reg2)) {
+				Copy (dst, reg1);
+				return;
+			}
+			if (reg1.count == 0) {
+				Copy (dst, reg2);
+				return;
+			}
+			if (reg2.count == 0) {
+				Copy (dst, reg1);
+				return;
+			}
+			if (reg1.count == 1 && Subsumes (reg1.extents, reg2.extents)) {
+				Copy (dst, reg1);
+				return;
+			}
+			if (reg2.count == 1 && Subsumes (reg2.extents, reg1.extents)) {
+				Copy (dst, reg2);
+				return;
+			}
+
+			var extents = new RegionBox {
+				X1 = Math.Min (reg1.extents.X1, reg2.extents.X1),
+				Y1 = Math.Min (reg1.extents.Y1, reg2.extents.Y1),
+				X2 = Math.Max (reg1.extents.X2, reg2.extents.X2),
+				Y2 = Math.Max (reg1.extents.Y2, reg2.extents.Y2)
+			};
+			Op (dst, reg1, reg2, UnionBand, true, true);
+			dst.extents = extents;
+		}
+
+		// pixman_region32_subtract: dst = minuend - subtrahend
+		internal static void Subtract (RegionGeometry dst, RegionGeometry minuend, RegionGeometry subtrahend)
+		{
+			if (minuend.count == 0 || subtrahend.count == 0 || !ExtentCheck (minuend.extents, subtrahend.extents)) {
+				Copy (dst, minuend);
+				return;
+			}
+			if (ReferenceEquals (minuend, subtrahend)) {
+				dst.extents.X2 = dst.extents.X1;
+				dst.extents.Y2 = dst.extents.Y1;
+				dst.SetEmpty ();
+				return;
+			}
+
+			Op (dst, minuend, subtrahend, SubtractBand, true, false);
+			SetExtents (dst);
+		}
+
+		// cairo_region_xor: no xor in pixman, so cairo composes (other - dst) | (dst - other) and so do we.
+		internal static void Xor (RegionGeometry dst, RegionGeometry other)
+		{
+			var difference = new RegionGeometry ();
+			Subtract (difference, other, dst);
+			Subtract (dst, dst, other);
+			Union (dst, dst, difference);
 		}
 	}
