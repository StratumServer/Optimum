+	// Issues opaque, never reused, non-zero handles and keeps the reference counts of live regions.
+	static class RegionHandles
+	{
+		static readonly object gate = new object ();
+		static readonly Dictionary<IntPtr, RegionState> live = new Dictionary<IntPtr, RegionState> ();
+		static long counter;
+
+		internal static IntPtr Create (RegionGeometry geometry)
+		{
+			lock (gate) {
+				IntPtr handle;
+				do {
+					counter++;
+					handle = (IntPtr) unchecked ((nint) (0x1000 + (counter << 4)));
+				} while (handle == IntPtr.Zero || live.ContainsKey (handle));
+				live.Add (handle, new RegionState (geometry));
+				return handle;
+			}
+		}
+
+		internal static RegionState Get (IntPtr handle)
+		{
+			lock (gate) {
+				RegionState state;
+				if (!live.TryGetValue (handle, out state))
+					throw new ArgumentException ("handle does not identify a live region", "handle");
+				return state;
+			}
+		}
+
+		internal static void Reference (IntPtr handle)
+		{
+			lock (gate) {
+				RegionState state;
+				if (live.TryGetValue (handle, out state))
+					state.ReferenceCount++;
+			}
+		}
+
+		internal static void Release (IntPtr handle)
+		{
+			lock (gate) {
+				RegionState state;
+				if (live.TryGetValue (handle, out state) && --state.ReferenceCount <= 0)
+					live.Remove (handle);
+			}
+		}
+
+		internal static int ReferenceCountOf (IntPtr handle)
+		{
+			lock (gate) {
+				RegionState state;
+				return live.TryGetValue (handle, out state) ? state.ReferenceCount : 0;
+			}
+		}
+	}
