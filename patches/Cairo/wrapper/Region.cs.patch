+		internal static RegionGeometry FromRectangle (RectangleInt rectangle)
+		{
+			var geometry = new RegionGeometry ();
+			geometry.InitRect (rectangle.X, rectangle.Y, rectangle.Width, rectangle.Height);
+			return geometry;
