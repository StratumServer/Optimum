+		// pixman_region32_init_rect: width and height are unsigned there, so the end coordinates wrap like int sums.
+		internal void InitRect (int x, int y, int width, int height)
+		{
+			var box = new RegionBox { X1 = x, Y1 = y, X2 = unchecked (x + width), Y2 = unchecked (y + height) };
+			if (!(box.X1 < box.X2 && box.Y1 < box.Y2)) {
+				Reset ();
+				return;
+			}
+			SetSingle (box);
+		}
