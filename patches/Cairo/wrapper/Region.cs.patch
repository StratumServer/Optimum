+		// cairo_region_create_rectangles + pixman_region32_init_rects: empty and malformed rectangles are dropped
+		// and the rest is merged into the canonical banded form.
+		internal void InitRects (RectangleInt[] rects, int length)
+		{
+			if (length == 1) {
+				InitRect (rects[0].X, rects[0].Y, rects[0].Width, rects[0].Height);
+				return;
+			}
