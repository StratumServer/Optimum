+		static void WriteCompressedRgb (Stream output, byte[] bgra, int width, int height)
+		{
+			using var compressed = new MemoryStream ();
+			using (var zlib = new ZLibStream (compressed, CompressionLevel.Optimal, true)) {
+				byte[] row = new byte [checked (width * 3)];
+				for (int y = 0; y < height; y++) {
+					int source = checked (y * width * 4);
+					for (int x = 0, target = 0; x < width; x++, source += 4) {
+						int white = 255 - bgra [source + 3];
+						row [target++] = (byte)Math.Min (255, bgra [source + 2] + white);
+						row [target++] = (byte)Math.Min (255, bgra [source + 1] + white);
+						row [target++] = (byte)Math.Min (255, bgra [source] + white);
+					}
+					zlib.Write (row, 0, row.Length);
+				}
+			}
+			compressed.Position = 0;
+			WriteAscii85 (output, compressed);
+		}
