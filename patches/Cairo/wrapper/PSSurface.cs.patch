+		static void WriteAscii85 (Stream output, Stream input)
+		{
+			byte [] block = new byte [4];
+			Span<byte> encoded = stackalloc byte [5];
+			int lineLength = 0;
+			int count;
+			while ((count = ReadBlock (input, block)) > 0) {
+				uint value = ((uint)block [0] << 24) | ((uint)block [1] << 16) | ((uint)block [2] << 8) | block [3];
+				if (count == 4 && value == 0) {
+					WriteAscii85Char (output, 'z', ref lineLength);
+					continue;
+				}
+				for (int i = 4; i >= 0; i--) { encoded [i] = (byte)(value % 85 + '!'); value /= 85; }
+				for (int i = 0; i < count + 1; i++) WriteAscii85Char (output, (char)encoded [i], ref lineLength);
+			}
+			WriteAscii (output, "~>\n");
+		}
+
+		static int ReadBlock (Stream input, byte [] block)
+		{
+			Array.Clear (block, 0, block.Length);
+			int count = 0, read;
+			while (count < block.Length && (read = input.Read (block, count, block.Length - count)) > 0) count += read;
+			return count;
+		}
+
+		static void WriteAscii85Char (Stream output, char value, ref int lineLength)
+		{
