+	// Managed cairo_device_t: reference count, sticky status, finished flag and the recursive acquire/release lock.
+	sealed class DeviceState
+	{
+		// CAIRO_STATUS_DEVICE_FINISHED: the public Status enum has no member for it, but the value is what
+		// cairo_device_acquire returned for a finished device.
+		internal const Status DeviceFinished = (Status) 37;
+
+		readonly object gate = new object ();
+		internal int ReferenceCount = 1;
+		internal readonly DeviceType Type;
+		internal Status Status = Status.Success;
+		internal bool Finished;
+		internal int MutexDepth;
+
+		internal DeviceState (DeviceType type)
+		{
+			Type = type;
+		}
+
+		internal Status Acquire ()
+		{
+			if (Status != Status.Success)
+				return Status;
+
+			if (Finished) {
+				Status = DeviceFinished;
+				return Status;
+			}
+
+			Monitor.Enter (gate);
+			MutexDepth++;
+			return Status.Success;
+		}
+
+		// cairo asserts that the caller holds the device; releasing without holding it is ignored here.
+		internal void Release ()
+		{
+			if (!Monitor.IsEntered (gate))
+				return;
+
+			MutexDepth--;
+			Monitor.Exit (gate);
+		}
+
+		internal void Flush ()
+		{
+			// No backend flush callback: nothing to write out.
+		}
+
+		internal void Finish ()
+		{
+			if (Finished)
+				return;
+
+			Flush ();
+			Finished = true;
+		}
+	}
+
+	// Issues opaque, never reused, non-zero handles for managed devices and keeps their reference counts.
+	static class DeviceHandles
+	{
+		static readonly object gate = new object ();
+		static readonly Dictionary<IntPtr, DeviceState> live = new Dictionary<IntPtr, DeviceState> ();
+		static long counter;
+
+		// Creates a device holding one reference, like the cairo_*_create functions return.
+		internal static IntPtr Create (DeviceType type)
+		{
+			lock (gate) {
+				IntPtr handle;
+				do {
+					counter++;
+					handle = (IntPtr) unchecked ((nint) (0x1000 + (counter << 4)));
+				} while (handle == IntPtr.Zero || live.ContainsKey (handle));
+				live.Add (handle, new DeviceState (type));
+				return handle;
+			}
+		}
+
+		internal static DeviceState Reference (IntPtr handle)
+		{
+			lock (gate) {
+				DeviceState state;
+				if (!live.TryGetValue (handle, out state))
+					throw new ArgumentException ("handle does not identify a live device", "handle");
+				state.ReferenceCount++;
+				return state;
+			}
+		}
+
+		internal static void Destroy (IntPtr handle)
+		{
+			DeviceState finished = null;
+			lock (gate) {
+				DeviceState state;
+				if (live.TryGetValue (handle, out state) && --state.ReferenceCount <= 0) {
+					live.Remove (handle);
+					finished = state;
+				}
+			}
+			if (finished != null)
+				finished.Finish ();
+		}
+
+		internal static int ReferenceCountOf (IntPtr handle)
+		{
+			lock (gate) {
+				DeviceState state;
+				return live.TryGetValue (handle, out state) ? state.ReferenceCount : 0;
+			}
+		}
+	}
