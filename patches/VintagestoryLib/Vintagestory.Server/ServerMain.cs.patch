+	// Optimum: per-tick cache for AllOnlinePlayers (avoids LINQ Select+Where+ToArray per access).
+	// TickPosition increments each server tick; first access after a tick rebuilds the array.
+	// No field initializer: Cecil field injection never runs it (the vanilla
+	// .ctor is not a transplant target), so the array fields default to null,
+	// not Array.Empty<IPlayer>(), and the tick fields default to 0, not -1.
+	// The null check below (not just the tick comparison) is load-bearing: it
+	// covers the case where the very first access happens to land on
+	// TickPosition == 0, where a tick-only comparison would wrongly treat the
+	// still-null array as already cached and return null instead of rebuilding.
+	private IPlayer[] optimumCachedOnlinePlayers;
+	private int optimumCachedOnlinePlayersTick;
+	private IPlayer[] optimumCachedAllPlayers;
+	private int optimumCachedAllPlayersTick;
+
+	public IPlayer[] AllOnlinePlayers
+	{
+		get
+		{
+			int tick = TickPosition;
+			if (optimumCachedOnlinePlayers == null || tick != optimumCachedOnlinePlayersTick)
+			{
+				// Rebuild: plain foreach, no LINQ, no closure allocation
+				var clients = Clients.Values;
+				int count = 0;
+				foreach (var c in clients)
+				{
+					if (c.Player != null) count++;
+				}
+				var result = new IPlayer[count];
+				int idx = 0;
+				foreach (var c in clients)
+				{
+					if (c.Player != null) result[idx++] = c.Player;
+				}
+				optimumCachedOnlinePlayers = result;
+				optimumCachedOnlinePlayersTick = tick;
+			}
+			return optimumCachedOnlinePlayers;
+		}
+	}
 
