+using System.Threading;
 using Vintagestory.Common;
 
 namespace Vintagestory.Server;
@@ -5,4 +6,26 @@ namespace Vintagestory.Server;
 internal class BoxedPacket_ServerAssets : BoxedPacket
 {
 	internal Packet_Server packet;
+	internal byte[] compressedBuffer;
+	internal int compressedLengthSent;
+	internal object compressionLock;
+	internal volatile bool isCompressedCached;
+
+	internal void Invalidate()
+	{
+		if (compressionLock == null)
+		{
+			Interlocked.CompareExchange(ref compressionLock, new object(), null);
+		}
+		lock (compressionLock)
+		{
+			isCompressedCached = false;
+			compressedBuffer = null;
+			compressedLengthSent = 0;
+			packet = null;
+			buffer = null;
+			Length = 0;
+			LengthSent = 0;
+		}
+	}
 }
