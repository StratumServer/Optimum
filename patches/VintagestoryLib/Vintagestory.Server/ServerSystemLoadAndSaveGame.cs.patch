+
+	private void TryStartOptimumChunkReadPool()
+	{
+		try
+		{
+			if (!Vintagestory.API.Config.OptimumConfig.ChunkReadPoolEnabled)
+			{
+				ServerMain.Logger.Notification("[Optimum] Chunk read pool disabled by config.");
+				return;
+			}
+			string dbFile = server.GetSaveFilepath();
+			if (!System.IO.File.Exists(dbFile)) return;
+
+			int workers = Vintagestory.API.Config.OptimumConfig.ChunkReadPoolWorkers;
+			chunkthread.optimumReadPool = new OptimumChunkReadPool(dbFile, workers, server.Config.CorruptionProtection);
+			ServerMain.Logger.Notification("[Optimum] Chunk read pool: {0} read-only connections @ {1}",
+				chunkthread.optimumReadPool.WorkerCount, System.IO.Path.GetFileName(dbFile));
+		}
+		catch (Exception ex)
+		{
+			ServerMain.Logger.Warning("[Optimum] Chunk read pool failed to start: {0}", ex.Message);
+			chunkthread.optimumReadPool = null;
+		}
+	}
