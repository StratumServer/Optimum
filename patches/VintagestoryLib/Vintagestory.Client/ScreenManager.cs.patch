+	private static void FadeAndDisposeIntroMusicWorker(object state)
+	{
+		if (state is not ILoadedSound loadedSound)
+		{
+			return;
+		}
+		try
+		{
+			float volume = loadedSound.Params?.Volume ?? 0f;
+			while (!loadedSound.IsDisposed && !loadedSound.HasStopped && Platform?.IsShuttingDown != true && (double)(loadedSound.Params?.Volume ?? 0f) > 0.01)
