 public class ItemTypeNet : CollectibleNet
 {
+	[ThreadStatic]
+	private static string lastAttributesJson;
+
+	[ThreadStatic]
+	private static JToken lastParsedAttributesToken;
+
+	internal static void ClearAttributesCache()
+	{
+		lastAttributesJson = null;
+		lastParsedAttributesToken = null;
+	}
+
+	private static JsonObject ParseAttributes(string json)
+	{
+		if (string.IsNullOrEmpty(json) || json == "{}")
+		{
+			return new JsonObject(new JObject());
+		}
+		if (string.Equals(json, lastAttributesJson, StringComparison.Ordinal) && lastParsedAttributesToken != null)
+		{
+			return new JsonObject(lastParsedAttributesToken.DeepClone());
+		}
+		lastAttributesJson = json;
+		lastParsedAttributesToken = JToken.Parse(json);
+		return new JsonObject(lastParsedAttributesToken.DeepClone());
+	}
+
