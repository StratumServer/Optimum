+				revealTextureId = optimumOitCachedRevealIds[i];
+				accumTextureId = optimumOitCachedAccumIds[i];
+				return true;
+			}
+		}
+		return false;
+	}
+
+	internal static void OptimumStoreCachedOit(FrameBufferRef targetFb, int revealTex, int accumTex, int width, int height)
+	{
+		OptimumEnsureOitCacheAllocated();
+		OptimumEvictOitEntryForFb(targetFb);
+		if (optimumOitCacheCount >= OptimumOitCacheCapacity)
+		{
+			OptimumRemoveOitCacheAt(0);
+		}
+		int idx = optimumOitCacheCount++;
+		optimumOitCachedFbs[idx] = targetFb;
+		optimumOitCachedRevealIds[idx] = revealTex;
+		optimumOitCachedAccumIds[idx] = accumTex;
+		optimumOitCachedWidths[idx] = width;
+		optimumOitCachedHeights[idx] = height;
+	}
+
+	internal static void OptimumFreeAllOitResources()
+	{
+		if (optimumOitCachedFbs != null && optimumOitCacheCount > 0)
