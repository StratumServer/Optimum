+	private static void OptimumEnsureOitCacheAllocated()
+	{
+		if (optimumOitCachedFbs != null) return;
+		optimumOitCachedFbs = new FrameBufferRef[OptimumOitCacheCapacity];
+		optimumOitCachedRevealIds = new int[OptimumOitCacheCapacity];
+		optimumOitCachedAccumIds = new int[OptimumOitCacheCapacity];
+		optimumOitCachedWidths = new int[OptimumOitCacheCapacity];
+		optimumOitCachedHeights = new int[OptimumOitCacheCapacity];
+	}
+
+	private static void OptimumRemoveOitCacheAt(int index)
+	{
+		if (optimumOitCachedAccumIds[index] != 0) GL.DeleteTexture(optimumOitCachedAccumIds[index]);
+		if (optimumOitCachedRevealIds[index] != 0) GL.DeleteTexture(optimumOitCachedRevealIds[index]);
+		int last = optimumOitCacheCount - 1;
+		for (int i = index; i < last; i++)
+		{
+			optimumOitCachedFbs[i] = optimumOitCachedFbs[i + 1];
+			optimumOitCachedRevealIds[i] = optimumOitCachedRevealIds[i + 1];
+			optimumOitCachedAccumIds[i] = optimumOitCachedAccumIds[i + 1];
+			optimumOitCachedWidths[i] = optimumOitCachedWidths[i + 1];
+			optimumOitCachedHeights[i] = optimumOitCachedHeights[i + 1];
+		}
+		optimumOitCachedFbs[last] = null;
+		optimumOitCachedRevealIds[last] = 0;
+		optimumOitCachedAccumIds[last] = 0;
+		optimumOitCachedWidths[last] = 0;
+		optimumOitCachedHeights[last] = 0;
+		optimumOitCacheCount = last;
+	}
+
+	internal static void OptimumCleanupDisposedOitEntries()
+	{
+		if (optimumOitCachedFbs == null || optimumOitCacheCount == 0) return;
+		for (int i = optimumOitCacheCount - 1; i >= 0; i--)
+		{
+			FrameBufferRef fb = optimumOitCachedFbs[i];
+			if (fb == null || fb.Disposed)
+			{
+				OptimumRemoveOitCacheAt(i);
+			}
+		}
+	}
+
+	internal static void OptimumEvictOitEntryForFb(FrameBufferRef targetFb)
+	{
+		if (optimumOitCachedFbs == null || targetFb == null) return;
+		for (int i = optimumOitCacheCount - 1; i >= 0; i--)
+		{
+			if (ReferenceEquals(optimumOitCachedFbs[i], targetFb))
+			{
+				OptimumRemoveOitCacheAt(i);
+			}
+		}
+	}
+
+	internal static bool OptimumTryActivateCachedOit(FrameBufferRef targetFb)
+	{
+		if (targetFb == null || targetFb.Disposed) return false;
+		OptimumCleanupDisposedOitEntries();
+		if (optimumOitCachedFbs == null) return false;
+		for (int i = 0; i < optimumOitCacheCount; i++)
+		{
+			if (ReferenceEquals(optimumOitCachedFbs[i], targetFb)
+				&& optimumOitCachedWidths[i] == targetFb.Width
+				&& optimumOitCachedHeights[i] == targetFb.Height
+				&& optimumOitCachedRevealIds[i] != 0
+				&& optimumOitCachedAccumIds[i] != 0)
