+	internal static bool TryFindShapeInDict(
+		Vintagestory.API.Datastructures.OrderedDictionary<AssetLocation, UnloadableShape> shapesDict,
+		AssetLocation shapeLoc,
+		out UnloadableShape shape)
+	{
+		if (shapesDict == null || shapeLoc == null)
+		{
+			shape = null;
+			return false;
+		}
+		if (shapesDict.TryGetValue(shapeLoc, out shape))
+		{
+			return shape != null;
+		}
+		string path = shapeLoc.Path;
+		if (path != null && (path.StartsWith("shapes/", StringComparison.Ordinal) || path.EndsWith(".json", StringComparison.Ordinal)))
+		{
+			int start = path.StartsWith("shapes/", StringComparison.Ordinal) ? 7 : 0;
+			int len = path.Length - start;
+			if (len >= 5 && path.EndsWith(".json", StringComparison.Ordinal))
+			{
+				len -= 5;
+			}
+			if (len > 0)
+			{
+				AssetLocation normalized = new AssetLocation(shapeLoc.Domain, path.Substring(start, len));
+				if (shapesDict.TryGetValue(normalized, out shape))
+				{
+					return shape != null;
+				}
+			}
+		}
+		shape = null;
+		return false;
+	}
+
+	private void EnsureLoadedForLazy(AssetLocation shapeLoc, List<UnloadableShape> reloaded)
+	{
+		if (shapes == null || shapeLoc == null)
+		{
+			return;
+		}
+		if (TryFindShapeInDict(shapes, shapeLoc, out UnloadableShape shape) && !shape.Loaded)
+		{
+			shape.Load(game, new AssetLocationAndSource(shapeLoc));
+			if (!shape.keepLoaded && ClientSettings.OptimizeRamMode == 2)
+			{
+				reloaded.Add(shape);
+			}
+		}
+	}
+
+	private static void ReUnloadTemporaryShapes(List<UnloadableShape> reloaded)
+	{
+		if (reloaded == null || reloaded.Count == 0)
+		{
+			return;
+		}
+		for (int i = 0; i < reloaded.Count; i++)
+		{
+			UnloadableShape shape = reloaded[i];
+			if (!shape.keepLoaded)
+			{
+				shape.Unload();
+			}
+		}
+		reloaded.Clear();
+	}
