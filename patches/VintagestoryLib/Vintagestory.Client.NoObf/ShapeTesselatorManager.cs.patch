+	private bool BlockCompositeShapeUsesColormap(Block block, CompositeShape compositeShape, ref Dictionary<AssetLocation, bool> shapeColormapCache)
+	{
+		if (compositeShape == null || compositeShape.Format != EnumShapeFormat.VintageStory || compositeShape.VoxelizeTexture)
+		{
+			return false;
+		}
+		if (block.ClimateColorMap != null || block.SeasonColorMap != null)
+		{
+			return true;
+		}
+		if (ShapeAssetUsesColormap(compositeShape.Base, ref shapeColormapCache))
+		{
+			return true;
+		}
+		CompositeShape[] overlays = compositeShape.Overlays;
+		if (overlays != null)
+		{
+			for (int i = 0; i < overlays.Length; i++)
+			{
+				CompositeShape overlay = overlays[i];
+				if (overlay != null && overlay.Format == EnumShapeFormat.VintageStory && !overlay.VoxelizeTexture && ShapeAssetUsesColormap(overlay.Base, ref shapeColormapCache))
+				{
+					return true;
+				}
+			}
+		}
+		CompositeShape[] alternates = compositeShape.BakedAlternates;
+		if (alternates != null)
+		{
+			for (int i = 0; i < alternates.Length; i++)
+			{
+				CompositeShape alt = alternates[i];
+				if (alt != null && alt.Format == EnumShapeFormat.VintageStory && !alt.VoxelizeTexture)
+				{
+					if (ShapeAssetUsesColormap(alt.Base, ref shapeColormapCache))
+					{
+						return true;
+					}
+					CompositeShape[] altOverlays = alt.Overlays;
+					if (altOverlays != null)
+					{
+						for (int j = 0; j < altOverlays.Length; j++)
+						{
+							CompositeShape altOverlay = altOverlays[j];
+							if (altOverlay != null && altOverlay.Format == EnumShapeFormat.VintageStory && !altOverlay.VoxelizeTexture && ShapeAssetUsesColormap(altOverlay.Base, ref shapeColormapCache))
+							{
+								return true;
+							}
+						}
+					}
+				}
+			}
+		}
+		return false;
+	}
+
+	private bool ShapeAssetUsesColormap(AssetLocation shapeLoc, ref Dictionary<AssetLocation, bool> shapeColormapCache)
+	{
+		if (shapeLoc == null || shapes == null)
+		{
+			return false;
+		}
+		shapeColormapCache ??= new Dictionary<AssetLocation, bool>();
+		if (shapeColormapCache.TryGetValue(shapeLoc, out bool cached))
+		{
+			return cached;
+		}
+		bool usesColormap = false;
+		if (TryFindShapeInDict(shapes, shapeLoc, out UnloadableShape shape))
+		{
+			if (game != null)
+			{
+				shape.AcquirePinAndEnsureLoaded(game, new AssetLocationAndSource(shapeLoc));
+			}
+			else
+			{
+				shape.AcquirePin();
+			}
+			try
+			{
+				usesColormap = ShapeElementsUseColormap(shape.Elements);
+			}
+			finally
+			{
+				shape.ReleasePin();
+			}
+		}
+		shapeColormapCache[shapeLoc] = usesColormap;
+		return usesColormap;
+	}
+
+	private static bool ShapeElementsUseColormap(ShapeElement[] elements)
+	{
+		if (elements == null)
+		{
+			return false;
+		}
+		for (int i = 0; i < elements.Length; i++)
+		{
+			ShapeElement element = elements[i];
+			if (element == null)
+			{
+				continue;
+			}
+			if (element.HasFaces() && (!string.IsNullOrEmpty(element.ClimateColorMap) || !string.IsNullOrEmpty(element.SeasonColorMap)))
+			{
+				return true;
+			}
+			if (element.Children != null && ShapeElementsUseColormap(element.Children))
+			{
+				return true;
+			}
+		}
+		return false;
 	}
 
