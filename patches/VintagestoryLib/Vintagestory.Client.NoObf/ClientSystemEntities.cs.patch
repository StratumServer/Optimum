+	internal static void UpdateBlockEntityFromPacket(BlockEntity entity, Packet_BlockEntity packet, ClientMain game, bool isNew)
+	{
+		TreeAttribute treeAttribute = new TreeAttribute();
+		if (packet.TryGetOptimumDataSpan(out byte[] dataBuf, out int dataOffset, out int dataLength))
+		{
+			if (Vintagestory.API.Config.OptimumConfig.SpanBlockEntitySerializationEnabled)
+			{
+				Vintagestory.API.Config.OptimumTreeAttributeCodec.ReadTreeFromBytes(treeAttribute, dataBuf, dataOffset, dataLength);
+			}
+			else
+			{
+				using MemoryStream input = new MemoryStream(dataBuf, dataOffset, dataLength);
+				using BinaryReader stream = new BinaryReader(input);
+				treeAttribute.FromBytes(stream);
+			}
+		}
+		packet.ClearOptimumSlice();
+		if (isNew)
+		{
+			Block blockRaw = game.BlockAccessor.GetBlockRaw(treeAttribute.GetInt("posx"), treeAttribute.GetInt("posy"), treeAttribute.GetInt("posz"), 1);
+			entity.CreateBehaviors(blockRaw, game);
+		}
+		entity.FromTreeAttributes(treeAttribute, game);
+	}
