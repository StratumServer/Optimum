+			&& (OptimumGlVersionAtLeast(3, 1) || OptimumHasGlExtension("GL_ARB_copy_buffer"))
+			&& (OptimumGlVersionAtLeast(3, 2) || OptimumHasGlExtension("GL_ARB_sync"))
+			&& (OptimumGlVersionAtLeast(3, 0) || OptimumHasGlExtension("GL_ARB_map_buffer_range"));
