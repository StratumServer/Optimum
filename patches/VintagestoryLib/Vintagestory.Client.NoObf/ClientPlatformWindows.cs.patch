+	/// <summary>
+	/// Optimum: glGetTexImage of level 0 in the parity dump's representation -
+	/// RGBA/UNSIGNED_BYTE for 8-bit unsigned-normalised formats, DEPTH_COMPONENT/FLOAT
+	/// for depth, RGBA/FLOAT otherwise - rows bottom-up as GL returns them. Unbinds
+	/// the pixel-pack buffer for the read (the screenshot path leaves one bound) and
+	/// restores it, the 2D binding and the pack alignment afterwards.
+	/// </summary>
+	private OptimumTextureReadback OptimumParityReadTextureGl(int textureId)
+	{
+		int previousTexture;
+		GL.GetInteger((GetPName)32873, out previousTexture);
+		int previousPackBuffer;
+		GL.GetInteger((GetPName)35053, out previousPackBuffer);
+		int previousPackAlignment;
+		GL.GetInteger((GetPName)3333, out previousPackAlignment);
+		GL.BindBuffer((BufferTarget)35051, 0);
+		GL.PixelStore((PixelStoreParameter)3333, 1);
+		GL.BindTexture((TextureTarget)3553, textureId);
+
+		int width;
+		GL.GetTexLevelParameter((TextureTarget)3553, 0, (GetTextureParameter)4096, out width);
+		int height;
+		GL.GetTexLevelParameter((TextureTarget)3553, 0, (GetTextureParameter)4097, out height);
+		int internalFormat;
+		GL.GetTexLevelParameter((TextureTarget)3553, 0, (GetTextureParameter)4099, out internalFormat);
+
+		OptimumTextureReadback readback = null;
+		if (width > 0 && height > 0)
+		{
+			readback = new OptimumTextureReadback();
+			readback.GlInternalFormat = internalFormat;
+			readback.Width = width;
+			readback.Height = height;
+			if (OptimumParityDump.IsDepthFormat(internalFormat))
+			{
+				float[] depth = new float[width * height];
+				GL.GetTexImage((TextureTarget)3553, 0, (PixelFormat)6402, (PixelType)5126, depth);
+				readback.Floats = depth;
+			}
+			else if (OptimumParityDump.IsUnorm8Format(internalFormat))
+			{
+				byte[] bytes = new byte[width * height * 4];
+				GL.GetTexImage((TextureTarget)3553, 0, (PixelFormat)6408, (PixelType)5121, bytes);
+				readback.Bytes = bytes;
+			}
+			else
+			{
+				float[] floats = new float[width * height * 4];
+				GL.GetTexImage((TextureTarget)3553, 0, (PixelFormat)6408, (PixelType)5126, floats);
+				readback.Floats = floats;
+			}
+		}
+
+		GL.BindTexture((TextureTarget)3553, previousTexture);
+		GL.PixelStore((PixelStoreParameter)3333, previousPackAlignment);
+		GL.BindBuffer((BufferTarget)35051, previousPackBuffer);
+		return readback;
+	}
