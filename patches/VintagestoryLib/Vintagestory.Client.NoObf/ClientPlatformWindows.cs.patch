+	// Thread.Sleep's default granularity on Windows (commonly 15.6ms, and Windows 11 22H2+ leaves
+	// the 1ms system timer off unless an app requests it) makes the coarse-sleep phase of frame
+	// pacing overshoot unpredictably. Raising it to 1ms shrinks that overshoot for every sleep call
+	// in the process, not just this one, with no measurable downside.
+	private static void EnsureOptimumTimerResolution()
+	{
+		if (_optimumTimerResolutionRaised) return;
+		_optimumTimerResolutionRaised = true;
+		if (!OperatingSystem.IsWindows()) return;
+		OptimumTimeBeginPeriod(1);
+		// A plain "+= OptimumOnProcessExit" method-group conversion makes the C# compiler emit a
+		// hidden static delegate-cache class (<>O) to avoid reallocating the delegate on repeated
+		// calls; the Cecil patcher's self-reference check can't resolve that compiler-generated
+		// type against the vanilla target and rejects the transplant (same "lambda-freedom"
+		// constraint docs/todo.md documents for Packet_Server). Building the delegate through
+		// reflection instead avoids the method-group conversion entirely, so no cache class is
+		// generated, and we get the documented timeBeginPeriod/timeEndPeriod pairing for free.
+		System.Reflection.MethodInfo exitHandlerMethod = typeof(ClientPlatformWindows).GetMethod(
+			"OptimumOnProcessExit",
+			System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Static);
+		EventHandler exitHandler = (EventHandler)Delegate.CreateDelegate(typeof(EventHandler), exitHandlerMethod);
+		AppDomain.CurrentDomain.ProcessExit += exitHandler;
+	}
