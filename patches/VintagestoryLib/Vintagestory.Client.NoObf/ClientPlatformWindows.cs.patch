+	private bool ConsumeOptimumChunkUploadGlErrors(out string errors)
+	{
+		errors = null;
+		try
+		{
+			for (int i = 0; i < 64; i++)
+			{
+				OpenTK.Graphics.OpenGL.ErrorCode error = GL.GetError();
+				if (error == OpenTK.Graphics.OpenGL.ErrorCode.NoError) return true;
+				errors = errors == null ? error.ToString() : errors + ", " + error;
+			}
+			errors = (errors ?? "unknown") + ", queue did not clear after 64 queries";
+			return false;
+		}
+		catch (Exception exception)
+		{
+			errors = "glGetError failed: " + exception.GetType().Name;
+			return false;
+		}
+	}
+
+	private bool EnsureOptimumChunkUploadRing()
+	{
+		if (_optimumChunkUploadRingInitialized) return _optimumChunkUploadRingBuffer != 0 && !_optimumChunkUploadRingDisabled;
+		_optimumChunkUploadRingInitialized = true;
+		if (!_optimumChunkUploadRingSupported || _optimumChunkUploadRingDisabled) return false;
+		IntPtr contextHandle = CurrentOptimumChunkUploadContextHandle();
+		if (contextHandle == IntPtr.Zero)
+		{
+			_optimumChunkUploadRingDisabled = true;
+			return false;
+		}
+		_optimumChunkUploadRingCurrentSegment = -1;
+		_optimumChunkUploadRingNextSegment = 0;
+		_optimumChunkUploadRingSegmentStates = new int[OptimumChunkUploadRingSegmentCount];
+		_optimumChunkUploadRingFences = new IntPtr[OptimumChunkUploadRingSegmentCount];
+		_optimumChunkUploadRingCursors = new int[OptimumChunkUploadRingSegmentCount];
+
+		int previousCopyWriteBinding = 0;
+		int buffer = 0;
+		IntPtr mapped = IntPtr.Zero;
+		string operationFailure = null;
+		if (!ConsumeOptimumChunkUploadGlErrors(out string pendingErrors))
+		{
+			_optimumChunkUploadRingDisabled = true;
+			if (logger != null) logger.Warning("Optimum chunk upload staging disabled because OpenGL errors could not be isolated: {0}", pendingErrors);
+			return false;
+		}
+		if (pendingErrors != null && logger != null)
+		{
+			logger.Warning("Optimum chunk upload staging cleared pre-existing OpenGL errors before initialization: {0}", pendingErrors);
+		}
+		try
+		{
+			GL.GetInteger((GetPName)0x8F37, out previousCopyWriteBinding);
+			buffer = GL.GenBuffer();
+			GL.BindBuffer((BufferTarget)0x8F37, buffer);
+			GL.BufferStorage((BufferTarget)0x8F37, OptimumChunkUploadRingTotalBytes, IntPtr.Zero, (BufferStorageFlags)0xC2);
+			mapped = GL.MapBufferRange((BufferTarget)0x8F37, IntPtr.Zero, OptimumChunkUploadRingTotalBytes, (MapBufferAccessMask)0xC2);
+		}
+		catch (Exception exception)
+		{
+			operationFailure = exception.GetType().Name;
+		}
+		try
+		{
+			GL.BindBuffer((BufferTarget)0x8F37, previousCopyWriteBinding);
+		}
+		catch (Exception exception)
+		{
+			operationFailure = operationFailure ?? ("binding restore failed: " + exception.GetType().Name);
+		}
+		bool errorQueueCleared = ConsumeOptimumChunkUploadGlErrors(out string initializationErrors);
+		if (operationFailure != null || !errorQueueCleared || initializationErrors != null || buffer == 0 || mapped == IntPtr.Zero)
+		{
+			try
+			{
+				if (buffer != 0) GL.DeleteBuffer(buffer);
+			}
+			catch
+			{
+			}
+			ConsumeOptimumChunkUploadGlErrors(out string cleanupErrors);
+			_optimumChunkUploadRingDisabled = true;
+			if (logger != null)
+			{
+				string reason = operationFailure ?? initializationErrors ?? (buffer == 0 ? "buffer allocation returned zero" : "persistent mapping returned null");
+				if (cleanupErrors != null) reason += ", cleanup: " + cleanupErrors;
+				logger.Warning("Optimum chunk upload staging initialization failed: {0}", reason);
+			}
+			return false;
+		}
+		_optimumChunkUploadRingBuffer = buffer;
+		_optimumChunkUploadRingMapped = mapped;
+		_optimumChunkUploadRingContextHandle = contextHandle;
+		return true;
+	}
+
+	private void BeginOptimumChunkUploadFrame()
+	{
+		_optimumChunkUploadFrameActive = true;
+		_optimumChunkUploadFrameBytes = 0;
+		if (!Vintagestory.API.Config.OptimumConfig.ChunkUploadStagingRingEnabled || !_optimumChunkUploadRingSupported || _optimumChunkUploadRingDisabled)
+		{
+			return;
+		}
+		if (!EnsureOptimumChunkUploadRing()) return;
+		if (!HasOptimumChunkUploadRingContext()) return;
+
+		for (int i = 0; i < OptimumChunkUploadRingSegmentCount; i++)
+		{
+			if (_optimumChunkUploadRingSegmentStates[i] != OptimumChunkUploadSegmentInFlight || _optimumChunkUploadRingFences[i] == IntPtr.Zero) continue;
+			WaitSyncStatus status;
+			try
+			{
+				status = GL.ClientWaitSync(_optimumChunkUploadRingFences[i], (ClientWaitSyncFlags)1, 0UL);
+			}
+			catch
+			{
+				_optimumChunkUploadRingSegmentStates[i] = OptimumChunkUploadSegmentQuarantined;
+				_optimumChunkUploadRingDisabled = true;
+				_optimumChunkUploadRingContextLost = true;
+				return;
+			}
+			int result = (int)status;
+			if (result == 0x911A || result == 0x911C)
+			{
+				GL.DeleteSync(_optimumChunkUploadRingFences[i]);
+				_optimumChunkUploadRingFences[i] = IntPtr.Zero;
+				_optimumChunkUploadRingCursors[i] = 0;
+				_optimumChunkUploadRingSegmentStates[i] = OptimumChunkUploadSegmentFree;
+			}
+			else if (result == 0x911D)
+			{
+				_optimumChunkUploadRingSegmentStates[i] = OptimumChunkUploadSegmentQuarantined;
+				_optimumChunkUploadRingDisabled = true;
+				_optimumChunkUploadRingContextLost = true;
+				return;
+			}
+		}
+	}
+
+	private bool AcquireOptimumChunkUploadSegment()
+	{
+		for (int attempt = 0; attempt < OptimumChunkUploadRingSegmentCount; attempt++)
+		{
+			int index = (_optimumChunkUploadRingNextSegment + attempt) % OptimumChunkUploadRingSegmentCount;
+			if (_optimumChunkUploadRingSegmentStates[index] != OptimumChunkUploadSegmentFree) continue;
+			_optimumChunkUploadRingCursors[index] = 0;
+			_optimumChunkUploadRingSegmentStates[index] = OptimumChunkUploadSegmentRecording;
+			_optimumChunkUploadRingCurrentSegment = index;
+			_optimumChunkUploadRingNextSegment = (index + 1) % OptimumChunkUploadRingSegmentCount;
+			return true;
+		}
+		return false;
+	}
+
+	private void SealOptimumChunkUploadSegment()
+	{
+		if (_optimumChunkUploadRingSegmentStates == null || _optimumChunkUploadRingFences == null || _optimumChunkUploadRingCursors == null)
+		{
+			_optimumChunkUploadRingCurrentSegment = -1;
+			return;
+		}
+		int index = _optimumChunkUploadRingCurrentSegment;
+		if (index < 0) return;
+		_optimumChunkUploadRingCurrentSegment = -1;
+		if (_optimumChunkUploadRingCursors[index] == 0)
+		{
+			_optimumChunkUploadRingSegmentStates[index] = OptimumChunkUploadSegmentFree;
+			return;
+		}
+		IntPtr fence = IntPtr.Zero;
+		try
+		{
+			fence = GL.FenceSync((ArbSync)0x9117, 0);
+		}
+		catch
+		{
+		}
+		if (fence == IntPtr.Zero)
+		{
+			ConsumeOptimumChunkUploadGlErrors(out string fenceErrors);
+			_optimumChunkUploadRingSegmentStates[index] = OptimumChunkUploadSegmentQuarantined;
+			_optimumChunkUploadRingDisabled = true;
+			if (logger != null) logger.Warning("Optimum chunk upload staging disabled because GL.FenceSync returned null: {0}", fenceErrors ?? "no OpenGL error was reported");
+			return;
+		}
+		_optimumChunkUploadRingFences[index] = fence;
+		_optimumChunkUploadRingSegmentStates[index] = OptimumChunkUploadSegmentInFlight;
+	}
+
+	public void BeginOptimumChunkUploadScope()
+	{
+		if (!_optimumChunkUploadFrameActive || !Vintagestory.API.Config.OptimumConfig.ChunkUploadStagingRingEnabled) return;
+		if (_optimumChunkUploadScopeDepth++ != 0 || _optimumChunkUploadDirectStateAccess || _optimumChunkUploadRingBuffer == 0 || _optimumChunkUploadRingDisabled) return;
+		try
+		{
+			GL.GetInteger((GetPName)0x8F36, out _optimumChunkUploadSavedCopyReadBinding);
+			GL.GetInteger((GetPName)0x8F37, out _optimumChunkUploadSavedCopyWriteBinding);
+			GL.BindBuffer((BufferTarget)0x8F36, _optimumChunkUploadRingBuffer);
+			_optimumChunkUploadScopeBoundBuffers = true;
+		}
+		catch
+		{
+			_optimumChunkUploadRingDisabled = true;
+		}
+	}
+
+	public void EndOptimumChunkUploadScope()
+	{
+		if (_optimumChunkUploadScopeDepth <= 0) return;
+		if (--_optimumChunkUploadScopeDepth != 0 || !_optimumChunkUploadScopeBoundBuffers) return;
+		try
+		{
+			GL.BindBuffer((BufferTarget)0x8F36, _optimumChunkUploadSavedCopyReadBinding);
+			GL.BindBuffer((BufferTarget)0x8F37, _optimumChunkUploadSavedCopyWriteBinding);
+		}
+		catch
+		{
+			_optimumChunkUploadRingDisabled = true;
+		}
+		finally
+		{
+			_optimumChunkUploadScopeBoundBuffers = false;
+		}
+	}
+
+	private unsafe bool TryOptimumStageChunkUpload(IntPtr source, int byteCount, int destinationBuffer, int destinationOffset)
+	{
+		if (_optimumChunkUploadScopeDepth <= 0 || !_optimumChunkUploadFrameActive || !Vintagestory.API.Config.OptimumConfig.ChunkUploadStagingRingEnabled)
+		{
+			return false;
+		}
+		if (!_optimumChunkUploadRingSupported || _optimumChunkUploadRingBuffer == 0 || _optimumChunkUploadRingDisabled)
+		{
+			Vintagestory.API.Config.OptimumChunkStreamStats.RecordUploadRingFallback(byteCount, Vintagestory.API.Config.OptimumChunkStreamStats.UploadRingFallbackReason.RingFailure);
+			return false;
+		}
+		if (byteCount <= 0) return false;
+		if (byteCount > OptimumChunkUploadRingSegmentBytes)
+		{
+			Vintagestory.API.Config.OptimumChunkStreamStats.RecordUploadRingFallback(byteCount, Vintagestory.API.Config.OptimumChunkStreamStats.UploadRingFallbackReason.Oversized);
+			return false;
+		}
+
+		int alignedBytes = (byteCount + 15) & ~15;
+		if (_optimumChunkUploadRingCurrentSegment < 0 || _optimumChunkUploadRingCursors[_optimumChunkUploadRingCurrentSegment] + alignedBytes > OptimumChunkUploadRingSegmentBytes)
+		{
+			SealOptimumChunkUploadSegment();
+			if (_optimumChunkUploadRingDisabled || !AcquireOptimumChunkUploadSegment())
+			{
+				Vintagestory.API.Config.OptimumChunkStreamStats.RecordUploadRingFallback(byteCount, Vintagestory.API.Config.OptimumChunkStreamStats.UploadRingFallbackReason.Capacity);
+				return false;
+			}
+		}
+
+		int segment = _optimumChunkUploadRingCurrentSegment;
