+	// Sizes the grid for the current view distance and world height. Runs on the culling
+	// thread at the start of a pass; every later step of the pass reads the grid object's
+	// own dimensions, so a view distance change cannot tear a pass. The area is the
+	// square of radius viewDistance / 32 + 4 around the camera chunk (the vanilla octagon
+	// shell is viewDistance / 32 + 1 and the ray budget reaches up to +3 past the shell),
+	// and +/- (world height + 2) vertically.
+	private void bfsPrepareGrid()
+	{
+		if (bfsGrid == null)
+		{
+			bfsGrid = new OptimumChunkVisibilityGrid();
+		}
+		bfsGrid.Prepare(ClientSettings.ViewDistance / 32 + 4, game.WorldMap.ChunkMapSizeY + 2);
+		// The chunk references are cleared at the end of every pass, so a reused array is empty.
+		if (bfsChunkGrid == null || bfsChunkGrid.Length < bfsGrid.CellCount)
+		{
+			bfsChunkGrid = new ClientChunk[bfsGrid.CellCount];
+		}
+	}
+
+	// Optimum issue #72 (after tehtelev's ChunkCuller): one pass over the loaded chunks
+	// that resets visibility and copies each chunk inside the grid area into the flat
+	// grid, with its traversability bits. Runs under chunksLock. The key is decoded as
+	// ChunkIndex3D inverted: key = (y * mulZ + z) * mulX + x; keys of other dimensions
+	// produce a y far outside the grid and are skipped.
+	private void bfsResetAndFill(Dictionary<long, ClientChunk> chunks)
+	{
+		OptimumChunkVisibilityGrid grid = bfsGrid;
+		ClientChunk[] chunkGrid = bfsChunkGrid;
+		int w = grid.Width;
+		int h = grid.Height;
+		int r = grid.RadiusXZ;
+		int ry = grid.RadiusY;
+		long mulX = game.WorldMap.index3dMulX;
+		long mulXZ = mulX * game.WorldMap.index3dMulZ;
+		long cx = centerpos.X;
+		long cy = centerpos.Y;
+		long cz = centerpos.Z;
+		foreach (KeyValuePair<long, ClientChunk> item in chunks)
+		{
+			ClientChunk chunk = item.Value;
+			chunk.SetVisible(visible: false);
+			long key = item.Key;
+			long y = key / mulXZ;
+			long ly = y - cy + ry;
+			if ((ulong)ly >= (ulong)h)
+			{
+				continue;
+			}
+			long rem = key - y * mulXZ;
+			long z = rem / mulX;
+			long lz = z - cz + r;
+			long lx = rem - z * mulX - cx + r;
+			if ((ulong)lx >= (ulong)w || (ulong)lz >= (ulong)w)
+			{
+				continue;
+			}
+			int idx = (int)((ly * w + lz) * w + lx);
+			chunkGrid[idx] = chunk;
+			// Plain reads of the same fields vanilla's IsTraversable reads, which the chunk visibility
+			// thread rewrites without a lock. A recalculation that sees the bits of a regeneration in
+			// progress can hide the chunk until the next one, as in vanilla; closing that window needs
+			// the writer in SystemChunkVisibilityCalc to publish the bits before the flag.
+			bool fresh = chunk.traversabilityFresh;
+			grid.SetCell(idx, OptimumChunkVisibilityGrid.EncodeCell(chunk.traversability, fresh));
+		}
+	}
+
+	// Optimum issue #72: breadth-first visibility walk over the flat grid, run outside
+	// chunksLock on the snapshot taken by bfsResetAndFill, then the reached loaded chunks
+	// are marked visible. Like the vanilla raycast it only marks reachable chunks; the
+	// mesh pools frustum-cull afterwards.
+	private void runFlatBfsVisibility(bool useOcclusion)
+	{
+		OptimumChunkVisibilityGrid grid = bfsGrid;
+		grid.Run(centerpos.X, centerpos.Y, centerpos.Z, game.WorldMap.ChunkMapSizeX, game.WorldMap.ChunkMapSizeY, game.WorldMap.ChunkMapSizeZ, useOcclusion);
+		ClientChunk[] chunkGrid = bfsChunkGrid;
+		int count = grid.QueueLength;
+		for (int i = 0; i < count; i++)
+		{
+			ClientChunk chunk = chunkGrid[grid.ReachedCell(i)];
+			if (chunk != null)
+			{
+				chunk.SetVisible(visible: true);
+			}
+		}
+		// Drop the chunk references so unloaded chunks are not kept alive until the next pass.
+		Array.Clear(chunkGrid, 0, grid.CellCount);
+	}
+
+	// Measurement-only (issue #72 A/B): counts chunks currently marked visible in
+	// the buffer the walk just wrote (CullVisible[(bufIndex+1)%2]), before the
+	// SwapVisibleBuffers below. Used only when CullWalkLogEnabled to compare the
+	// raycast vs BFS visible sets in the same scene, so the O(chunks) scan never
+	// runs on a normal frame.
+	private int countVisibleMarked()
+	{
+		int buf = (ClientChunk.bufIndex + 1) % 2;
+		int n = 0;
+		lock (game.WorldMap.chunksLock)
+		{
+			foreach (KeyValuePair<long, ClientChunk> kv in game.WorldMap.chunks)
+			{
+				if (kv.Value.CullVisible[buf])
+				{
+					n++;
+				}
+			}
+		}
+		return n;
+	}
