+internal sealed class OptimumMainThreadMipmapTask
+{
+	private readonly TextureAtlasManager owner;
+
+	private readonly int atlasNumber;
+
+	private bool secondPass;
+
+	public OptimumMainThreadMipmapTask(TextureAtlasManager owner, int atlasNumber)
+	{
+		this.owner = owner;
+		this.atlasNumber = atlasNumber;
+	}
+
+	public void Run()
+	{
+		if (!secondPass)
+		{
+			secondPass = true;
+			owner.EnqueueFollowupMipmapTask(Run);
+			return;
+		}
+		owner.FinishMipmapGeneration(atlasNumber);
+	}
+}
