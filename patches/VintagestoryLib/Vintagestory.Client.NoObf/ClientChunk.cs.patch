+	internal bool OptimumRecordDirty(bool priority, bool edgeOnly)
+	{
+		Interlocked.Increment(ref optimumEdgeDirtySeq);
+		if (!edgeOnly)
+		{
+			Interlocked.Increment(ref optimumFullDirtySeq);
+		}
+		while (true)
+		{
+			int cur = Volatile.Read(ref optimumTessState);
+			if ((cur & 1) != 0)
+			{
+				int next = cur | 2 | (edgeOnly ? 0 : 4) | (priority ? 8 : 0);
+				if (Interlocked.CompareExchange(ref optimumTessState, next, cur) == cur)
+				{
+					return false;
+				}
+			}
+			else
+			{
+				int next = cur | 16;
+				if (Interlocked.CompareExchange(ref optimumTessState, next, cur) == cur)
+				{
+					return true;
+				}
+			}
+		}
+	}
+
+	internal bool OptimumTryBeginWorkerTesselation(bool priority, bool skipChunkCenter, out int fullSeq, out int edgeSeq)
+	{
+		while (true)
+		{
+			int cur = Volatile.Read(ref optimumTessState);
+			if ((cur & 1) != 0)
+			{
+				int next = cur | 2 | (skipChunkCenter ? 0 : 4) | (priority ? 8 : 0);
+				if (Interlocked.CompareExchange(ref optimumTessState, next, cur) == cur)
+				{
+					fullSeq = 0;
+					edgeSeq = 0;
+					return false;
+				}
+			}
+			else
+			{
+				int next = (cur & ~30) | 1;
+				if (Interlocked.CompareExchange(ref optimumTessState, next, cur) == cur)
+				{
+					fullSeq = Volatile.Read(ref optimumFullDirtySeq);
+					edgeSeq = Volatile.Read(ref optimumEdgeDirtySeq);
+					return true;
+				}
+			}
+		}
+	}
+
+	internal void OptimumFinishWorkerTesselation(bool wantRetry, bool retryPriority, bool retryEdgeOnly, out bool shouldEnqueue, out bool outPriority, out bool outEdgeOnly)
+	{
+		while (true)
+		{
+			int cur = Volatile.Read(ref optimumTessState);
+			bool pending = (cur & 2) != 0;
+			bool mergedFull = (cur & 4) != 0 || (wantRetry && !retryEdgeOnly);
+			bool mergedPriority = (cur & 8) != 0 || (wantRetry && retryPriority);
+			shouldEnqueue = pending || wantRetry;
+			int next = shouldEnqueue ? 16 : 0;
+			if (Interlocked.CompareExchange(ref optimumTessState, next, cur) == cur)
+			{
+				outPriority = mergedPriority;
+				outEdgeOnly = !mergedFull;
+				return;
+			}
+		}
+	}
