+	// Optimum (DLSS plan, Phase 6): the upscaler rows.
+	//
+	// An upscaler is a whole-chain decision, exactly like TAA: it owns the temporal
+	// resolve, the frame is rendered at a size the vendor chooses, and every target
+	// downstream of the resolve moves between the render size and the display size.
+	// So the handler persists the choice and then re-plans and rebuilds through the
+	// platform (ApplyOptimumUpscalerSettings, whose neutral body is
+	// RebuildFrameBuffers), reloads the shaders - the motion writers are compiled
+	// against "does anything temporal want this frame jittered", which changes when
+	// the upscaler is the only temporal consumer - and drops the history, because a
+	// history produced by the other configuration would be reprojected into a frame
+	// that never made it.
+	//
+	// Switching to off is the same path in reverse and restores the pre-upscaler
+	// chain exactly: the rebuild allocates the TAA history slots and the sharpen
+	// target again, and OptimumConfig.UpscalerReplacesTaa goes false, which is the
+	// one condition the in-house resolve, the sharpen pass and the FSR 1 blit stand
+	// down on.
+	private void onOptimumUpscalerChanged(string code, bool selected)
+	{
+		// Asked about the entry that was picked, not about the slot in general: the
+		// passthrough comparison upscaler needs no vendor runtime, so it stays
+		// selectable on a machine where DLSS cannot come up - which is the machine
+		// the comparison is most worth running on.
+		string unavailable = (ScreenManager.Platform != null) ? ScreenManager.Platform.OptimumUpscalerUnavailableFor(code) : "no platform";
+		if (unavailable != null && !string.Equals(code, "off", StringComparison.OrdinalIgnoreCase))
+		{
+			// The row has already moved by the time the handler runs, so refusing has
+			// to put it back: the frame is not going to upscale, and a row left on
+			// "DLSS" would claim it does.
+			optimumUpdateUpscalerRows();
+			return;
+		}
+		Vintagestory.API.Config.OptimumConfig.Upscaler = code;
+		Vintagestory.API.Config.OptimumConfig.Save();
+		if (ScreenManager.Platform != null)
+		{
+			ScreenManager.Platform.ApplyOptimumUpscalerSettings();
+		}
+		handler.ReloadShaders();
+		OptimumTemporal.RequestReset(EnumTemporalResetReason.Toggle);
+		optimumUpdateUpscalerRows();
+	}
+
+	// The preset only changes the render size the vendor asks for, so this is the
+	// re-plan and the rebuild without the shader reload: every define, every motion
+	// writer and every uniform is the same on both sides of it.
