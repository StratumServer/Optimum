+	private GuiElementContainer optimumContainer;
+	// Assigned in OnOptimumOptions: the IL patcher injects members without field initializers.
+	private Dictionary<string, GuiElement> optimumControls;
+
+	// The rows live in a GuiElementContainer: it re-renders its children with its own
+	// bounds each frame, so moving the container moves labels, controls and tooltips
+	// together. Composer-level switches, sliders and dropdowns bake their frames into
+	// the dialog's static texture and cannot follow a scroll offset.
+	private void OnOptimumScrollChanged(float value)
+	{
+		if (optimumContainer == null) return;
+		optimumContainer.Bounds.fixedY = 0f - value;
+		optimumContainer.Bounds.CalcWorldBounds();
+		foreach (GuiElement element in optimumContainer.Elements)
+		{
+			if (element is GuiElementDropDown dropDown && dropDown.listMenu.IsOpened)
+			{
+				dropDown.listMenu.Close();
+			}
+		}
+	}
+
+	private static string GetOptimumLabelFeature(string labelKey)
+	{
+		switch (labelKey)
+		{
+			case "optimum-greedymesh": return "GreedyMesh";
+			case "optimum-renderscale": return "RenderScale";
+			case "optimum-godrayscap": return "GodRaysSampleCap";
+			case "optimum-entitylightbatch": return "EntityLightBatch";
+			case "optimum-entityshadercache": return "EntityShaderStateCache";
+			default: return null;
+		}
+	}
+
+	private void AddOptimumLabelRow(string labelKey, string tooltipKey)
+	{
+		string feature = GetOptimumLabelFeature(labelKey);
+		bool blocked = feature != null && Vintagestory.API.Config.OptimumConfig.IsShaderFeatureDisabled(feature);
+		string label = Lang.Get(labelKey);
+		string tooltip = tooltipKey != null ? Lang.Get(tooltipKey) : null;
+		if (blocked)
+		{
+			label += " " + Lang.Get("optimum-compatibility-unavailable-suffix");
+			tooltip = Lang.Get("optimum-compatibility-why-" + feature);
+		}
+		ElementBounds labelBounds = ElementBounds.Fixed(0, optimumRowY, 400, 30);
+		optimumContainer.Add(new GuiElementStaticText(composer.Api, label, EnumTextOrientation.Left, labelBounds, CairoFont.WhiteSmallishText()));
+		if (tooltip != null)
+		{
+			ElementBounds hoverBounds = labelBounds.FlatCopy().WithFixedHeight(25);
+			optimumContainer.Add(new GuiElementHoverText(composer.Api, tooltip, CairoFont.WhiteSmallText(), 250, hoverBounds));
+		}
+	}
+
+	private void AddOptimumSwitchRow(string labelKey, string tooltipKey, Action<bool> onChanged, string key)
+	{
+		AddOptimumLabelRow(labelKey, tooltipKey);
+		GuiElementSwitch toggle = new GuiElementSwitch(composer.Api, onChanged, ElementBounds.Fixed(450, optimumRowY - 3, 200, 20));
+		optimumControls[key] = toggle;
+		optimumContainer.Add(toggle);
+		optimumRowY += 28;
+	}
+
+	private void AddOptimumSliderRow(string labelKey, ActionConsumable<int> onChanged, string key)
+	{
+		AddOptimumLabelRow(labelKey, null);
+		GuiElementSlider slider = new GuiElementSlider(composer.Api, onChanged, ElementBounds.Fixed(450, optimumRowY + 2, 200, 20));
+		optimumControls[key] = slider;
+		optimumContainer.Add(slider);
+		optimumRowY += 28;
+	}
+
+	private void AddOptimumDropdownRow(string labelKey, string tooltipKey, string[] values, string[] names, int selectedIndex, SelectionChangedDelegate onChanged, string key)
+	{
+		AddOptimumLabelRow(labelKey, tooltipKey);
+		GuiElementDropDown dropDown = new GuiElementDropDown(composer.Api, values, names, selectedIndex, onChanged, ElementBounds.Fixed(450, optimumRowY + 2, 200, 25), CairoFont.WhiteSmallText(), false);
+		optimumControls[key] = dropDown;
+		optimumContainer.Add(dropDown);
+		optimumRowY += 28;
+	}
+
+	private void AddOptimumCompatibilityText(string text, CairoFont font, double indent, double gapAfter)
+	{
+		double width = 650 - indent;
+		double height = new TextDrawUtil().GetMultilineTextHeight(font, text, width * ClientSettings.GUIScale) / ClientSettings.GUIScale;
+		optimumContainer.Add(new GuiElementStaticText(composer.Api, text, EnumTextOrientation.Left, ElementBounds.Fixed(indent, optimumRowY, width, height), font));
+		optimumRowY += height + gapAfter;
+	}
+
+	private void AddOptimumCompatibilityStatus()
+	{
+		string[] features = { "GreedyMesh", "RenderScale", "GodRaysSampleCap", "EntityLightBatch", "EntityShaderStateCache", "Oit", "MapPageCache", "ShaderPreprocessParallel" };
+		List<string> groupOrder = new List<string>();
+		Dictionary<string, List<string>> groups = new Dictionary<string, List<string>>();
+		foreach (string feature in features)
+		{
+			if (!Vintagestory.API.Config.OptimumConfig.IsShaderFeatureDisabled(feature)) continue;
+			DisableOptimumFeatureControl(feature);
+			string owners = Vintagestory.API.Config.OptimumConfig.GetShaderFeatureBlockMods(feature);
+			if (!groups.TryGetValue(owners, out List<string> members))
+			{
+				members = new List<string>();
+				groups[owners] = members;
+				groupOrder.Add(owners);
+			}
+			members.Add(feature);
+		}
+		optimumRowY += 12;
+		if (groupOrder.Count > 0)
+		{
+			AddOptimumCompatibilityText(Lang.Get("optimum-compatibility-blocked-header"), CairoFont.WhiteSmallishText(), 0, 4);
+			AddOptimumCompatibilityText(Lang.Get("optimum-compatibility-blocked-intro"), CairoFont.WhiteDetailText(), 0, 10);
+			foreach (string owners in groupOrder)
+			{
+				bool scanFailed = Vintagestory.API.Config.OptimumConfig.IsShaderCompatibilityScanFailed;
+				string heading = owners.Length > 0 ? Lang.Get("optimum-compatibility-caused-by", owners) : Lang.Get(scanFailed ? "optimum-compatibility-caused-by-scan" : "optimum-compatibility-caused-by-unknown");
+				AddOptimumCompatibilityText(heading, CairoFont.WhiteSmallText(), 0, 2);
+				foreach (string feature in groups[owners])
+				{
+					string row = Lang.Get("optimum-compatibility-feature", Lang.Get("optimum-compatibility-feature-name-" + feature), Lang.Get("optimum-compatibility-why-" + feature));
+					double rowTop = optimumRowY;
+					AddOptimumCompatibilityText(row, CairoFont.WhiteDetailText(), 16, 2);
+					ElementBounds hoverBounds = ElementBounds.Fixed(16, rowTop, 634, optimumRowY - rowTop);
+					optimumContainer.Add(new GuiElementHoverText(composer.Api, Vintagestory.API.Config.OptimumConfig.GetShaderFeatureBlockReason(feature), CairoFont.WhiteSmallText(), 400, hoverBounds));
+				}
+				optimumRowY += 8;
+			}
+		}
+		if (Vintagestory.API.Config.OptimumConfig.IsShaderCompatibilityReportStale)
+		{
+			AddOptimumCompatibilityText(Lang.Get("optimum-compatibility-report-stale"), CairoFont.WhiteDetailText(), 0, 8);
+		}
+		if (Vintagestory.API.Config.OptimumConfig.IsShaderCompatibilityReportMissing)
+		{
+			AddOptimumCompatibilityText(Lang.Get("optimum-compatibility-report-missing"), CairoFont.WhiteDetailText(), 0, 8);
+		}
+		else if (groupOrder.Count == 0)
+		{
+			AddOptimumCompatibilityText(Lang.Get("optimum-compatibility-clear"), CairoFont.WhiteDetailText(), 0, 8);
+		}
+	}
+
+	private void DisableOptimumFeatureControl(string feature)
+	{
+		switch (feature)
+		{
+#if OPTIMUM_GREEDY_MESH
+			case "GreedyMesh": ((GuiElementSwitch)optimumControls["optGreedyMesh"]).Enabled = false; break;
+#endif
+			case "RenderScale": ((GuiElementDropDown)optimumControls["optRenderScale"]).Enabled = false; break;
+			case "GodRaysSampleCap": ((GuiElementSwitch)optimumControls["optGodRaysCap"]).Enabled = false; break;
+			case "EntityLightBatch": ((GuiElementSwitch)optimumControls["optEntityLightBatch"]).Enabled = false; break;
+			case "EntityShaderStateCache": ((GuiElementSwitch)optimumControls["optEntityShaderCache"]).Enabled = false; break;
+		}
+	}
+
