+	// Optimum (DLSS plan, Phase 6 follow-up): how sharp the upscaler samples the
+	// atlases. The DLSS Programming Guide's section 3.5 recommends
+	// log2(render / display) - 1 and warns in the same breath that it "can
+	// sometimes lead to increased temporal instability, in the form of flickering
+	// and/or moire", with high-frequency textures as the case (3.5.1); the bound
+	// it gives is log2(render / display) itself. This row is that one term, so the
+	// player can trade the sharpness back for stability on the pixel-art atlas.
+	//
+	// Nothing structural moves with it. The render size is the vendor's and does
+	// not change, so no framebuffer is rebuilt and the NGX feature is not touched;
+	// no shader define depends on the bias, so no shader is reloaded; and the
+	// history is still valid for the frame that produced it, so it is not reset -
+	// a reset here would throw away exactly the accumulation the player is judging.
+	// Only the number the atlas parameters and the terrain sampler objects carry
+	// moves, through the one applier.
+	private bool onOptimumUpscalerSharpnessChanged(int val)
+	{
+		Vintagestory.API.Config.OptimumConfig.UpscalerLodBiasOffset = Math.Clamp(val / 100f, 0f, 1f);
+		Vintagestory.API.Config.OptimumConfig.Save();
+		Vintagestory.API.Config.OptimumConfig.RepublishUpscalerLodBias();
+		ShaderRegistry.ApplyOptimumLodBias();
+		optimumUpdateUpscalerRows();
+		return true;
+	}
