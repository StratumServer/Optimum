+	private void onOptimumRenderScaleChanged(string code, bool selected)
+	{
+		if (Vintagestory.API.Config.OptimumConfig.IsShaderFeatureDisabled("RenderScale")) return;
+		float scale = float.Parse(code, System.Globalization.CultureInfo.InvariantCulture);
+		ClientSettings.OptimumRenderScale = scale;
+		Vintagestory.API.Config.OptimumConfig.RenderScale = scale;
+		Vintagestory.API.Config.OptimumConfig.Save();
+		// FSR render scale works by lowering SSAA below 1.0 and upscaling.
+		// Override SSAA when render scale < 1.0; restore to 1.0 when native.
+		if (scale < 1.0f)
+		{
+			ClientSettings.SSAA = scale;
+		}
+		else
+		{
+			ClientSettings.SSAA = 1.0f;
+		}
+		ScreenManager.Platform.RebuildFrameBuffers();
+		handler.ReloadShaders();
+	}
+	private void onOptimumGodRaysCapChanged(bool on) { Vintagestory.API.Config.OptimumConfig.GodRaysSampleCapEnabled = on; Vintagestory.API.Config.OptimumConfig.Save(); }
+	private void onOptimumTaaChanged(bool on)
+	{
+		if (Vintagestory.API.Config.OptimumConfig.IsFeatureExplicitlyDisabled("Taa"))
+		{
+			// The switch has already flipped by the time the handler runs, so
+			// bail-out has to put it back: otherwise the UI claims TAA is on
+			// while EffectiveTaa stays false for the rest of the session.
+			composer?.GetSwitch("optTaa")?.SetValue(Vintagestory.API.Config.OptimumConfig.EffectiveTaa);
+			return;
+		}
+		Vintagestory.API.Config.OptimumConfig.Taa = on;
+		Vintagestory.API.Config.OptimumConfig.Save();
+		ScreenManager.Platform.RebuildFrameBuffers();
+		handler.ReloadShaders();
+		OptimumTemporal.RequestReset(EnumTemporalResetReason.Toggle);
+	}
+
