+	/// <summary>
+	/// Optimum: puts the three upscaler rows back in step with what the frame is
+	/// really doing - the selection shows the effective upscaler (a renderer that
+	/// stood DLSS down has already made it "off"), and the quality row is disabled
+	/// while nothing is upscaling, because a preset with no upscaler selects
+	/// nothing.
+	/// </summary>
+	private void optimumUpdateUpscalerRows()
+	{
+		if (composer == null) return;
+		GuiElementDropDown upscaler = composer.GetDropDown("optUpscaler");
+		if (upscaler != null)
+		{
+			upscaler.SetSelectedValue(Vintagestory.API.Config.OptimumConfig.EffectiveUpscaler);
+		}
+		GuiElementDropDown quality = composer.GetDropDown("optUpscalerQuality");
+		if (quality != null)
+		{
+			// Any upscaler that owns the resolve, not DLSS alone: the preset chooses the
+			// render size for the passthrough comparison upscaler too, which is the whole
+			// point of it - it renders at the size DLSS would have rendered at.
+			quality.Enabled = Vintagestory.API.Config.OptimumConfig.UpscalerReplacesTaa;
+		}
+		// The sharpness row follows the quality row exactly: it only describes how
+		// the upscaler samples the atlases, so with nothing upscaling it describes
+		// nothing. Its text carries the bias the current preset ends up with, which
+		// is the number the player is actually choosing.
+		GuiElementSlider sharpness = composer.GetSlider("optUpscalerSharpness");
+		if (sharpness != null)
+		{
+			sharpness.Enabled = Vintagestory.API.Config.OptimumConfig.UpscalerReplacesTaa;
+			sharpness.SetValues((int)Math.Round(Vintagestory.API.Config.OptimumConfig.UpscalerLodBiasOffset * 100f), 0, 100, 5, optimumUpscalerLodBiasText());
+		}
+		// The filter row is the passthrough upscaler's alone; the jitter row belongs to
+		// whichever upscaler owns the resolve, because the experiment is run against
+		// both of them.
+		GuiElementDropDown passthroughFilter = composer.GetDropDown("optUpscalerPassthroughFilter");
+		if (passthroughFilter != null)
+		{
+			passthroughFilter.Enabled = Vintagestory.API.Config.OptimumConfig.EffectiveUpscalerIsPassthrough;
+			passthroughFilter.SetSelectedValue(Vintagestory.API.Config.OptimumConfig.UpscalerPassthroughFilter);
+		}
+		GuiElementDropDown jitter = composer.GetDropDown("optUpscalerJitter");
+		if (jitter != null)
+		{
+			jitter.Enabled = Vintagestory.API.Config.OptimumConfig.UpscalerReplacesTaa;
+			jitter.SetSelectedValue(Vintagestory.API.Config.OptimumConfig.UpscalerJitter ? "on" : "off");
+		}
+		optimumUpdateUpscalePlanReadout();
+	}
