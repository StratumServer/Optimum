+	private static string GetOptimumLabelFeature(string labelKey)
+	{
+		switch (labelKey)
+		{
+			case "optimum-greedymesh":
+			case "optimum-greedymesh-preset": return "GreedyMesh";
+			case "optimum-renderscale": return "RenderScale";
+			case "optimum-godrayscap": return "GodRaysSampleCap";
+			case "optimum-entitylightbatch": return "EntityLightBatch";
+			case "optimum-entityshadercache": return "EntityShaderStateCache";
+			default: return null;
+		}
+	}
+
+	private void AddOptimumLabelRow(string labelKey, string tooltipKey, out double labelX, out double controlX, out double controlBaseY, out double rowHeight)
+	{
+		string feature = GetOptimumLabelFeature(labelKey);
+		bool blocked = feature != null && Vintagestory.API.Config.OptimumConfig.IsShaderFeatureDisabled(feature);
+		string label = Lang.Get(labelKey);
+		string tooltip = tooltipKey != null ? Lang.Get(tooltipKey) : null;
+		if (blocked)
+		{
+			label += " " + Lang.Get("optimum-compatibility-unavailable-suffix");
+			tooltip = Lang.Get("optimum-compatibility-why-" + feature);
+		}
+		labelX = optimumColumn == 0 ? 0.0 : 475.0;
+		controlX = optimumColumn == 0 ? 255.0 : 730.0;
+		double curY = optimumColumn == 0 ? optimumCol0Y : optimumCol1Y;
+		double labelWidth = 245.0;
+
+		CairoFont font = CairoFont.WhiteSmallishText();
+		double textHeight = new TextDrawUtil().GetMultilineTextHeight(font, label, labelWidth * ClientSettings.GUIScale) / ClientSettings.GUIScale;
+		rowHeight = Math.Max(38.0, textHeight + 12.0);
+
+		ElementBounds labelBounds = ElementBounds.Fixed(labelX, curY, labelWidth, Math.Max(25.0, textHeight + 2.0));
+		composer.AddStaticText(label, font, labelBounds);
+		if (tooltip != null)
+		{
+			ElementBounds hoverBounds = labelBounds.FlatCopy();
+			composer.AddHoverText(tooltip, CairoFont.WhiteSmallText(), 250, hoverBounds);
+		}
+
+		controlBaseY = textHeight > 24.0 ? curY + (textHeight - 20.0) / 2.0 : curY;
+	}
+
+	private void AddOptimumSwitchRow(string labelKey, string tooltipKey, Action<bool> onChanged, string key)
+	{
+		AddOptimumLabelRow(labelKey, tooltipKey, out double labelX, out double controlX, out double controlBaseY, out double rowHeight);
+		composer.AddSwitch(onChanged, ElementBounds.Fixed(controlX, controlBaseY + 2.0, 160.0, 20.0), key);
+		optimumControls[key] = composer.GetSwitch(key);
+		if (optimumColumn == 0) optimumCol0Y += rowHeight; else optimumCol1Y += rowHeight;
+	}
