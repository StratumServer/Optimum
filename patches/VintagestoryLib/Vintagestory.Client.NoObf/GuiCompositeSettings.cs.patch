+	/// <summary>
+	/// Optimum: the plan readout, re-read from the platform. Called on every change
+	/// the tab makes and once per frame from <c>Refresh</c> while the dialog is
+	/// open, because the plan only becomes the new one on the next frame that
+	/// creates the feature - a readout written once at compose time would show the
+	/// previous preset's numbers for as long as the page stayed open. Does nothing
+	/// on every other page: the element only exists on the upscaling tab.
+	/// </summary>
+	private void optimumUpdateUpscalePlanReadout()
+	{
+		if (composer == null) return;
+		GuiElementDynamicText readout = composer.GetDynamicText("optUpscalePlan");
+		if (readout == null) return;
+		// SetNewText is a no-op when the text is unchanged, which is every frame the
+		// plan is stable, so this costs one string compare per frame.
+		readout.SetNewText(optimumUpscalePlanText());
+	}
+
+	/// <summary>
+	/// Optimum: what the sharpness row appends to its value - the texture LOD bias
+	/// the current preset ends up with, from the live plan's ratio while an
+	/// upscaler is running and from the preset's nominal ratio before one is. So
+	/// the row reads "100 -> -1.59 mip" at Quality with the guide's default.
+	/// Invariant culture: it is a number in a fixed format, not prose.
+	/// </summary>
+	private string optimumUpscalerLodBiasText()
+	{
+		float bias = Vintagestory.API.Config.OptimumConfig.PreviewUpscalerLodBias();
+		return " -> " + bias.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) + " mip";
+	}
