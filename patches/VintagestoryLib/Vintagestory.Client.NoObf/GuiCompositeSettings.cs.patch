+	private void onOptimumRenderScaleChanged(string code, bool selected)
+	{
+		if (Vintagestory.API.Config.OptimumConfig.IsShaderFeatureDisabled("RenderScale")) return;
+		float scale = float.Parse(code, System.Globalization.CultureInfo.InvariantCulture);
+		ClientSettings.OptimumRenderScale = scale;
+		Vintagestory.API.Config.OptimumConfig.RenderScale = scale;
+		Vintagestory.API.Config.OptimumConfig.Save();
+		// FSR render scale works by lowering SSAA below 1.0 and upscaling.
+		// Override SSAA when render scale < 1.0; restore to 1.0 when native.
+		if (scale < 1.0f)
+		{
+			ClientSettings.SSAA = scale;
+		}
+		else
+		{
+			ClientSettings.SSAA = 1.0f;
+		}
+		ScreenManager.Platform.RebuildFrameBuffers();
+		handler.ReloadShaders();
+	}
