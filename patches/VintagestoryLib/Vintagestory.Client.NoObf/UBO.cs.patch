 	public override void Bind()
 	{
+		Vintagestory.API.Config.IOptimumGraphicsDevice optimumDevice = Vintagestory.API.Config.OptimumRender.Device;
+		if (optimumDevice != null)
+		{
+			optimumDevice.BindUniformBuffer(Handle);
+			return;
+		}
 		GL.BindBuffer((BufferTarget)35345, Handle);
 		GL.BindBufferBase((BufferRangeTarget)35345, 0, Handle);
 	}
 
 	public override void Dispose()
