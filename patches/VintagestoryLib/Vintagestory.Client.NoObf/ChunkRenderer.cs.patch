+			GL.BindTexture((TextureTarget)3553, textureIds[i]);
+			GL.TexParameter((TextureTarget)3553, (TextureParameterName)34049, bias);
+		}
+		GL.BindTexture((TextureTarget)3553, 0);
 	}
 
