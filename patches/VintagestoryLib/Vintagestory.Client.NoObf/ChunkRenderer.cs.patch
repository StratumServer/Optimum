+	private void ApplyOptimumTextureLodBias()
+	{
+		// Only apply LOD bias when FSR is active (RenderScale < 1.0).
+		// At 1.0, skip TexParameter calls entirely to match vanilla behavior.
+		if (ClientSettings.OptimumRenderScale >= 1.0f)
+		{
+			if (!float.IsNaN(optimumTextureLodBias))
+			{
+				GL.ActiveTexture((TextureUnit)33984);
+				for (int i = 0; i < textureIds.Length; i++)
+				{
+					GL.BindTexture((TextureTarget)3553, textureIds[i]);
+					GL.TexParameter((TextureTarget)3553, (TextureParameterName)34049, 0f);
+				}
+				GL.BindTexture((TextureTarget)3553, 0);
+				optimumTextureLodBias = float.NaN;
+			}
+			return;
+		}
+		float textureLodBias = MathF.Log2(Math.Clamp(Vintagestory.API.Config.OptimumConfig.EffectiveRenderScale, 0.5f, 1.0f));
+		if (Math.Abs(textureLodBias - optimumTextureLodBias) < 0.0001f)
+		{
+			return;
+		}
+		GL.ActiveTexture((TextureUnit)33984);
+		for (int i = 0; i < textureIds.Length; i++)
+		{
+			GL.BindTexture((TextureTarget)3553, textureIds[i]);
+			GL.TexParameter((TextureTarget)3553, (TextureParameterName)34049, textureLodBias);
+		}
+		GL.BindTexture((TextureTarget)3553, 0);
+		optimumTextureLodBias = textureLodBias;
 	}
 
