+			byte[] data = Asset.Data;
+			if (data == null || data.Length == 0)
+			{
+				return false;
+			}
+			using MemoryStream memoryStream = new MemoryStream(data, writable: false);
+			if (OptimumAudioBufferHelper.TryEstimateOggDurationAndFormat(memoryStream, out int channels, out int sampleRate, out float durationSeconds))
+			{
+				if (Channels == 0)
