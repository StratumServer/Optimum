+	internal float EnsureDurationMetadataKnown()
+	{
+		float num = Volatile.Read(ref cachedDurationSeconds);
+		if (num > 0f)
+		{
+			return num;
+		}
+		int num2 = Volatile.Read(ref sharedBufferBytes);
+		if (num2 > 0 && Channels > 0 && Rate > 0 && BitsPerSample > 0)
+		{
+			float num3 = 1f * (float)num2 / (float)(Rate * BitsPerSample / 8) / (float)Channels;
+			Volatile.Write(ref cachedDurationSeconds, num3);
+			return num3;
+		}
+		byte[] array = Volatile.Read(ref Pcm);
+		if (array != null && Channels > 0 && Rate > 0 && BitsPerSample > 0)
+		{
+			float num4 = 1f * (float)array.Length / (float)(Rate * BitsPerSample / 8) / (float)Channels;
+			Volatile.Write(ref cachedDurationSeconds, num4);
+			return num4;
+		}
+		if (Asset == null)
+		{
+			return 0f;
+		}
+		lock (GetDecodeLock())
+		{
+			num = Volatile.Read(ref cachedDurationSeconds);
+			if (num > 0f)
+			{
+				return num;
+			}
+			bool flag = false;
+			if (!Asset.IsLoaded() && Asset.Origin != null)
+			{
+				Asset.Origin.LoadAsset(Asset);
+				flag = true;
+			}
+			try
+			{
+				byte[] data = Asset.Data;
+				if (data == null || data.Length == 0)
+				{
+					return 0f;
+				}
+				using MemoryStream memoryStream = new MemoryStream(data, writable: false);
+				if (OptimumAudioBufferHelper.TryEstimateOggDurationAndFormat(memoryStream, out int channels, out int sampleRate, out float durationSeconds))
+				{
+					if (Channels == 0)
+					{
+						Channels = channels;
+					}
+					if (Rate == 0)
+					{
+						Rate = sampleRate;
+					}
+					Volatile.Write(ref cachedDurationSeconds, durationSeconds);
+					return durationSeconds;
+				}
+			}
+			finally
+			{
+				if (flag && Volatile.Read(ref Loaded) == 0 && Asset != null)
+				{
