+	internal void ReleaseSharedBuffer(int bufferId, int bufferEpoch, bool allowDeleteAutoUnload)
+	{
+		lock (GetBufferLock())
+		{
+			if (sharedBufferId != bufferId || sharedBufferEpoch != bufferEpoch)
+			{
+				return;
+			}
+			if (sharedBufferUsers > 0)
+			{
+				sharedBufferUsers--;
+			}
+			if (sharedBufferUsers == 0)
+			{
+				Volatile.Write(ref lastUnreferencedMs, Environment.TickCount64);
+				int num = Volatile.Read(ref AudioOpenAl.ContextGeneration);
+				if (AutoUnload && allowDeleteAutoUnload)
+				{
+					if (sharedBufferId != 0 && sharedBufferEpoch == num && ScreenManager.Platform?.IsShuttingDown != true)
+					{
+						AL.DeleteBuffer(sharedBufferId);
+					}
+					sharedBufferId = 0;
+					sharedBufferBytes = 0;
+					sharedBufferEpoch = 0;
+					lock (GetSharedBuffersLock())
+					{
+						activeSharedBuffers?.Remove(this);
+					}
+				}
+			}
+		}
+	}
