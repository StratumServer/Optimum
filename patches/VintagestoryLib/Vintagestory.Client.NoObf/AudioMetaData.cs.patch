+				return false;
+			}
+
+			num = Volatile.Read(ref AudioOpenAl.ContextGeneration);
+			int num2 = AL.GenBuffer();
+			if (num2 == 0)
+			{
+				return false;
+			}
+
+			int channels = Channels;
+			int rate = Rate;
+			int num3 = (BitsPerSample > 0) ? BitsPerSample : 16;
+			try
+			{
+				ALFormat soundFormat = AudioOpenAl.GetSoundFormat(channels, num3);
+				fixed (byte* pcm = array)
+				{
+					AL.BufferData(num2, soundFormat, (void*)pcm, array.Length, rate);
+				}
+				ALError error = AL.GetError();
+				AL.GetBuffer(num2, (ALGetBufferi)8196, out int actualBytes);
+				if ((int)error != 0 || actualBytes <= 0)
+				{
+					AL.DeleteBuffer(num2);
+					return false;
+				}
+			}
+			catch
+			{
+				try
+				{
+					AL.DeleteBuffer(num2);
+				}
+				catch
+				{
+				}
+				throw;
+			}
+
+			sharedBufferId = num2;
+			sharedBufferEpoch = num;
+			sharedBufferBytes = array.Length;
+			sharedBufferUsers = 1;
+			if (channels > 0 && rate > 0 && num3 > 0)
+			{
+				Volatile.Write(ref cachedDurationSeconds, 1f * (float)array.Length / (float)(rate * num3 / 8) / (float)channels);
+			}
+			lock (GetSharedBuffersLock())
+			{
+				GetActiveSharedBuffers().Add(this);
+			}
+			Volatile.Write(ref Loaded, 3);
+			ReleaseManagedPcm();
+
+			outBufferId = num2;
+			outEpoch = num;
+			outByteLength = sharedBufferBytes;
+			outChannels = channels;
+			outRate = rate;
+			outBitsPerSample = num3;
+			return true;
+		}
+	}
