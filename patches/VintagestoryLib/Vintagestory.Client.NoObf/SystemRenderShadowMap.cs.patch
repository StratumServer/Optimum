+	private bool OptimumIsExternalShadowRendererActive()
+	{
+		List<RenderHandler> list = game.eventManager?.renderersByStage?[(int)EnumRenderStage.ShadowFar];
+		if (list == null)
+		{
+			return false;
+		}
+		for (int i = 0; i < list.Count; i++)
+		{
+			RenderHandler handler = list[i];
+			string name = handler.ProfilingName;
+			if (name == "res" || name == "ret-sf" || name == "ree" || name == "mechnetwork")
+			{
+				continue;
+			}
+			if (handler.Renderer is AnimatableRenderer anim)
+			{
+				if (anim.ShouldRender)
+				{
+					return true;
+				}
+				continue;
+			}
+			return true;
+		}
+		return false;
+	}
