+			int layer = pageTextureArray.GetLayer(pageKey);
+			if (layer < 0 || !renderedPages.Add(pageKey))
+			{
+				continue;
+			}
+			worldPos.X = pageX * OptimumMapPageCache.PageLen * 32;
+			worldPos.Z = pageZ * OptimumMapPageCache.PageLen * 32;
+			mapElem.TranslateWorldPosToViewPos(worldPos, ref viewPos);
+			float screenX = (float)mapElem.Bounds.renderX + viewPos.X;
+			float screenY = (float)mapElem.Bounds.renderY + viewPos.Y;
+			pageRenderer.AddPage(screenX, screenY, pageScreenSize, pageScreenSize, layer);
+		}
+		pageRenderer.EndFrame(capi.Render.FrameWidth, capi.Render.FrameHeight);
+		foreach (KeyValuePair<FastVec2i, MultiChunkMapComponent> item in loadedMapData)
+		{
+			item.Value.Render(mapElem, dt);
+		}
