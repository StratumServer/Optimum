+		{
+			(int pageX, int pageZ) = OptimumMapPageCache.ChunkToPage(chunkCoord.X, chunkCoord.Y);
+			long pageKey = OptimumMapPageCache.PackPageCoord(pageX, pageZ);
+			if (!renderedPages.Add(pageKey))
+			{
+				continue;
+			}
+			int layer = pageTextureArray.GetLayer(pageKey);
+			if (layer < 0)
+			{
+				continue;
+			}
+			renderWorldPos.X = pageX * OptimumMapPageCache.PageLen * 32;
+			renderWorldPos.Z = pageZ * OptimumMapPageCache.PageLen * 32;
+			mapElem.TranslateWorldPosToViewPos(renderWorldPos, ref renderViewPos);
+			float screenX = (float)mapElem.Bounds.renderX + renderViewPos.X;
+			float screenY = (float)mapElem.Bounds.renderY + renderViewPos.Y;
+			pageRenderer.AddPage(screenX, screenY, pageScreenSize, pageScreenSize, layer);
+		}
+		pageRenderer.EndFrame(capi.Render.FrameWidth, capi.Render.FrameHeight);
+		foreach (KeyValuePair<FastVec2i, MultiChunkMapComponent> item in loadedMapData)
+		{
+			item.Value.Render(mapElem, dt);
+		}
+	}
