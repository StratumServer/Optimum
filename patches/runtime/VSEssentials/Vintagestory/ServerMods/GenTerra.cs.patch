+	public void InterpolateOctaves(
+		float[] indices,
+		LandformVariant[] landFormsByIndex,
+		int octaves,
+		double[] amps,
+		double[] thresholds)
+	{
+		int nzCount = 0;
+		for (int i = 0; i < indices.Length; i++)
+		{
+			float weight = indices[i];
+			if (weight != 0f)
+			{
+				CornerNonZeroIndices[nzCount] = i;
+				CornerNonZeroWeights[nzCount] = weight;
+				nzCount++;
+			}
+		}
+
+		for (int octave = 0; octave < octaves; octave++)
+		{
+			double amplitude = 0.0;
+			double threshold = 0.0;
+			for (int k = 0; k < nzCount; k++)
+			{
+				float weight = CornerNonZeroWeights[k];
+				LandformVariant variant = landFormsByIndex[CornerNonZeroIndices[k]];
+				amplitude += variant.TerrainOctaves[octave] * (double)weight;
+				threshold += variant.TerrainOctaveThresholds[octave] * (double)weight;
+			}
+			amps[octave] = amplitude;
+			thresholds[octave] = threshold;
+		}
+	}
