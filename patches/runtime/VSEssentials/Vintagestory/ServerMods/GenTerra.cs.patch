+	public static void MergeLayerFlags(bool[] solid, bool[] empty, bool[] localSolid, bool[] localEmpty)
+	{
+		int len = Math.Min(Math.Min(solid.Length, empty.Length), Math.Min(localSolid.Length, localEmpty.Length));
+		if (len == 0)
+		{
+			return;
+		}
+		ref byte sBase = ref Unsafe.As<bool, byte>(ref solid[0]);
+		ref byte eBase = ref Unsafe.As<bool, byte>(ref empty[0]);
+		ref byte lsBase = ref Unsafe.As<bool, byte>(ref localSolid[0]);
+		ref byte leBase = ref Unsafe.As<bool, byte>(ref localEmpty[0]);
+		int i = 0;
+		if (Vector256.IsHardwareAccelerated)
+		{
+			for (; i <= len - 32; i += 32)
+			{
+				(Vector256.LoadUnsafe(ref sBase, (nuint)i) & Vector256.LoadUnsafe(ref lsBase, (nuint)i)).StoreUnsafe(ref sBase, (nuint)i);
+				(Vector256.LoadUnsafe(ref eBase, (nuint)i) & Vector256.LoadUnsafe(ref leBase, (nuint)i)).StoreUnsafe(ref eBase, (nuint)i);
+			}
+		}
+		if (Vector128.IsHardwareAccelerated)
+		{
+			for (; i <= len - 16; i += 16)
+			{
+				(Vector128.LoadUnsafe(ref sBase, (nuint)i) & Vector128.LoadUnsafe(ref lsBase, (nuint)i)).StoreUnsafe(ref sBase, (nuint)i);
+				(Vector128.LoadUnsafe(ref eBase, (nuint)i) & Vector128.LoadUnsafe(ref leBase, (nuint)i)).StoreUnsafe(ref eBase, (nuint)i);
+			}
+		}
+		for (; i < len; i++)
+		{
+			solid[i] &= localSolid[i];
+			empty[i] &= localEmpty[i];
+		}
+	}
+
+	[MethodImpl(MethodImplOptions.AggressiveInlining)]
+	public bool IsSolid(int columnIndex, int posY)
+	{
+		return (ColumnBlockSolidities[columnIndex][posY >> 6] & (1UL << (posY & 63))) != 0;
+	}
+
+	[MethodImpl(MethodImplOptions.AggressiveInlining)]
+	public void SetSolid(int columnIndex, int posY)
+	{
+		ColumnBlockSolidities[columnIndex][posY >> 6] |= (1UL << (posY & 63));
+	}
+
+	[MethodImpl(MethodImplOptions.AggressiveInlining)]
+	public void ClearColumn(int columnIndex)
+	{
+		ulong[] bits = ColumnBlockSolidities[columnIndex];
+		Array.Clear(bits, 0, bits.Length);
+	}
