+
+internal sealed class OptimumGenTerraWorkspace
+{
+	public readonly float[] TaperTerrainYPos = new float[1024];
+
+	public readonly float[] TaperWeight = new float[1024];
+
+	public readonly ulong[][] ColumnBlockSolidities;
+
+	public readonly int[] WaterBlockIds = new int[1024];
+
+	public readonly bool[] LayerFullySolid;
+
+	public readonly bool[] LayerFullyEmpty;
+
+	public readonly int[] BorderIndicesByCardinal = new int[8];
+
+	public OptimumGenTerraWorkspace(int mapHeight)
+	{
+		int words = (mapHeight + 63) / 64;
+		ColumnBlockSolidities = new ulong[1024][];
+		for (int i = 0; i < 1024; i++)
+		{
+			ColumnBlockSolidities[i] = new ulong[words];
+		}
+		LayerFullySolid = new bool[mapHeight];
+		LayerFullyEmpty = new bool[mapHeight];
+		BorderIndicesByCardinal[(int)Cardinal.NorthEast] = 992;
+		BorderIndicesByCardinal[(int)Cardinal.SouthEast] = 0;
+		BorderIndicesByCardinal[(int)Cardinal.SouthWest] = 31;
+		BorderIndicesByCardinal[(int)Cardinal.NorthWest] = 1023;
+	}
+
+	public static ThreadLocal<OptimumGenTerraWorkspace> CreateThreadLocal(int mapHeight)
+	{
+		return new ThreadLocal<OptimumGenTerraWorkspace>(() => new OptimumGenTerraWorkspace(mapHeight));
+	}
+
+	[MethodImpl(MethodImplOptions.AggressiveInlining)]
+	public bool IsSolid(int columnIndex, int posY)
+	{
+		return (ColumnBlockSolidities[columnIndex][posY >> 6] & (1UL << (posY & 63))) != 0;
+	}
+
+	[MethodImpl(MethodImplOptions.AggressiveInlining)]
+	public void SetSolid(int columnIndex, int posY)
+	{
+		ColumnBlockSolidities[columnIndex][posY >> 6] |= (1UL << (posY & 63));
+	}
+
+	[MethodImpl(MethodImplOptions.AggressiveInlining)]
+	public void ClearColumn(int columnIndex)
+	{
+		ulong[] bits = ColumnBlockSolidities[columnIndex];
+		Array.Clear(bits, 0, bits.Length);
+	}
+}
