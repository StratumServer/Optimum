+	private OptimumBlockLayerWorkspace GetOptimumWorkspace()
+	{
+		ThreadLocal<OptimumBlockLayerWorkspace> tls = Volatile.Read(ref optimumWorkspaces);
+		if (tls == null)
+		{
+			long seed = api?.WorldManager?.Seed ?? 0;
+			ThreadLocal<OptimumBlockLayerWorkspace> created = OptimumBlockLayerWorkspace.CreateThreadLocal(seed);
+			tls = Interlocked.CompareExchange(ref optimumWorkspaces, created, null) ?? created;
+			if (!ReferenceEquals(tls, created))
+			{
+				created.Dispose();
+			}
+		}
+		return tls.Value;
+	}
