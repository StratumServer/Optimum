+	private MeshData GetPotStaticMesh(ITesselatorAPI tesselator, ItemStack contentStack)
+	{
+		if (Api is not ICoreClientAPI capi)
+		{
+			return null;
+		}
+		string key = "potInFirepitStaticMesh-" + contentStack.Collectible.Code;
+		if (capi.ObjectCache.TryGetValue(key, out object cachedMesh))
+		{
+			return ((MeshData)cachedMesh)?.Clone();
+		}
+		BlockCookedContainer potBlock = capi.World.GetBlock(contentStack.Collectible.CodeWithVariant("type", "cooked")) as BlockCookedContainer;
+		if (potBlock == null)
+		{
+			return null;
+		}
+		string basePath = "shapes/block/clay/pot-";
+		Shape potShape = Shape.TryGet(capi, basePath + "opened-empty.json");
+		if (potShape == null)
+		{
+			return null;
+		}
+		tesselator.TesselateShape(potBlock, potShape, out MeshData potMesh);
+		if (potMesh == null)
+		{
+			return null;
+		}
+		potMesh = potMesh.Clone();
+		potMesh.Translate(0f, 0.0625f, 0f);
+		Shape lidShape = Shape.TryGet(capi, basePath + "part-lid.json");
+		if (lidShape != null)
+		{
+			tesselator.TesselateShape(potBlock, lidShape, out MeshData lidMesh);
+			if (lidMesh != null)
+			{
+				lidMesh = lidMesh.Clone();
+				lidMesh.Translate(0f, 0.40625f, 0f);
+				potMesh.AddMeshData(lidMesh);
+			}
+		}
+		capi.ObjectCache[key] = potMesh;
+		return potMesh.Clone();
+	}
+
