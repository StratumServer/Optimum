+
+            public RotatedMeshKey(string code, string overrideTextureCode, bool forLOD2, float rotX, float rotY, float rotZ)
+            {
+                Code = code ?? string.Empty;
+                OverrideTextureCode = overrideTextureCode ?? string.Empty;
+                ForLOD2 = forLOD2;
+                RotXBits = BitConverter.SingleToInt32Bits(rotX == 0f ? 0f : rotX);
+                RotYBits = BitConverter.SingleToInt32Bits(rotY == 0f ? 0f : rotY);
+                RotZBits = BitConverter.SingleToInt32Bits(rotZ == 0f ? 0f : rotZ);
+            }
+
+            public bool Equals(RotatedMeshKey other)
+            {
+                return ForLOD2 == other.ForLOD2
+                    && RotXBits == other.RotXBits
+                    && RotYBits == other.RotYBits
+                    && RotZBits == other.RotZBits
+                    && string.Equals(Code, other.Code, StringComparison.Ordinal)
+                    && string.Equals(OverrideTextureCode, other.OverrideTextureCode, StringComparison.Ordinal);
+            }
+
+            public override bool Equals(object obj) => obj is RotatedMeshKey other && Equals(other);
+
+            public override int GetHashCode() => HashCode.Combine(Code, OverrideTextureCode, ForLOD2, RotXBits, RotYBits, RotZBits);
+        }
