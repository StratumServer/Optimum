+        public MeshData GetOrCreateRotatedMesh(IShapeTypeProps cprops, string overrideTextureCode, bool forLOD2, float rotateX, float angleY, float rotateZ)
+        {
+            MeshData baseMesh = GetOrCreateMesh(cprops, null, overrideTextureCode, forLOD2);
+            if (rotateX == 0f && angleY == 0f && rotateZ == 0f)
+            {
+                return baseMesh;
+            }
+
+            var rotatedDict = optimumRotatedMeshDict;
+            if (rotatedDict == null)
+            {
+                return baseMesh.Clone().Rotate(OptimumBlockOrigin, rotateX, angleY, rotateZ);
+            }
+
+            var key = new RotatedMeshKey(cprops.Code, overrideTextureCode, forLOD2, rotateX, angleY, rotateZ);
+            lock (rotatedDict)
+            {
+                if (rotatedDict.TryGetValue(key, out var cached))
+                {
+                    return cached;
+                }
+            }
+
+            MeshData rotated = baseMesh.Clone().Rotate(OptimumBlockOrigin, rotateX, angleY, rotateZ);
+            lock (rotatedDict)
+            {
+                if (rotatedDict.TryGetValue(key, out var existing))
+                {
+                    rotated.Dispose();
+                    return existing;
+                }
+                rotatedDict[key] = rotated;
+                return rotated;
+            }
+        }
