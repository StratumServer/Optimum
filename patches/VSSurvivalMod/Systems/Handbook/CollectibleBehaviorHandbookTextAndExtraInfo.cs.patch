+        private class HandbookCategoryCache
+        {
+            public List<ItemStack> AllCookingContainers = [];
+            public List<ItemStack> AllFuels = [];
+            public List<ItemStack> AllMolds = [];
+            public List<ItemStack> AllAnvils = [];
+            public Dictionary<int, List<KeyValuePair<ItemStack, ItemStack>>> BreakBlocksByDroppedId = [];
+            public Dictionary<int, List<KeyValuePair<ItemStack, ItemStack>>> HarvestBlocksByDroppedId = [];
+        }
+
+        private static HandbookCategoryCache getOrCreateHandbookCategoryCache(ICoreClientAPI capi, ItemStack[] allStacks)
+        {
+            return ObjectCacheUtil.GetOrCreate(capi, "optimumHandbookCategoryCache", () =>
+            {
+                var cache = new HandbookCategoryCache();
+                if (allStacks == null) return cache;
+
+                foreach (var aStack in allStacks)
+                {
+                    if (aStack.ItemAttributes?.KeyExists("cookingContainerSlots") == true)
+                    {
+                        cache.AllCookingContainers.Add(aStack);
+                    }
+
+                    var combustibleProps = aStack.Collectible?.GetCombustibleProperties(capi.World, aStack, null);
+                    if (combustibleProps?.BurnDuration != null || combustibleProps?.BurnTemperature != null)
+                    {
+                        cache.AllFuels.Add(aStack);
+                    }
+
+                    if (aStack.Collectible is BlockToolMold or BlockIngotMold)
+                    {
+                        cache.AllMolds.Add(aStack);
+                    }
+
+                    if (aStack.Collectible is BlockAnvil)
+                    {
+                        cache.AllAnvils.Add(aStack);
+                    }
+
+                    if (aStack.Block is { } block)
+                    {
+                        BlockDropItemStack[] droppedStacks = block.GetDropsForHandbook(aStack, capi.World.Player);
+                        if (droppedStacks != null)
+                        {
+                            for (int i = 0; i < droppedStacks.Length; i++)
+                            {
+                                ItemStack droppedStack = droppedStacks[i]?.ResolvedItemstack;
+                                if (droppedStack != null)
+                                {
+                                    if (!cache.BreakBlocksByDroppedId.TryGetValue(droppedStack.Id, out var dList))
+                                    {
+                                        dList = [];
+                                        cache.BreakBlocksByDroppedId[droppedStack.Id] = dList;
+                                    }
+                                    dList.Add(new KeyValuePair<ItemStack, ItemStack>(aStack, droppedStack));
+                                }
+                            }
+                        }
+
+                        var harvestedStacks = block.GetBehavior<BlockBehaviorHarvestable>()?.harvestedStacks ??
+                                              block.GetBehavior<BlockBehaviorFruitingBush>()?.harvestedStacks;
+
+                        if (harvestedStacks == null)
+                        {
+                            if (block is BlockFruitTreeBranch branch && branch.TypeProps.TryGetValue(aStack.Attributes.GetString("type", "unknown"), out var props))
+                            {
+                                harvestedStacks = props.FruitStacks;
+                            }
+                        }
+
+                        if (harvestedStacks != null)
+                        {
+                            foreach (var hStack in harvestedStacks)
+                            {
+                                ItemStack rStack = hStack?.ResolvedItemstack;
+                                if (rStack != null)
+                                {
+                                    if (!cache.HarvestBlocksByDroppedId.TryGetValue(rStack.Id, out var hList))
+                                    {
+                                        hList = [];
+                                        cache.HarvestBlocksByDroppedId[rStack.Id] = hList;
+                                    }
+                                    hList.Add(new KeyValuePair<ItemStack, ItemStack>(aStack, rStack));
+                                }
+                            }
+                        }
+                    }
+                }
+
+                return cache;
+            });
+        }
+
+        private static Dictionary<long, List<GridRecipe>> getOrCreateGridRecipesByOutput(ICoreClientAPI capi)
+        {
+            return ObjectCacheUtil.GetOrCreate(capi, "optimumHandbookGridRecipesByOutput", () =>
+            {
+                var dict = new Dictionary<long, List<GridRecipe>>();
+                if (capi.World?.GridRecipes == null) return dict;
+
+                void AddCandidate(EnumItemClass itemClass, int id, GridRecipe recipe)
+                {
+                    long key = ((long)(int)itemClass << 32) | (uint)id;
+                    if (!dict.TryGetValue(key, out var list))
+                    {
+                        list = [];
+                        dict[key] = list;
+                    }
+                    if (!list.Contains(recipe))
+                    {
+                        list.Add(recipe);
+                    }
+                }
+
+                foreach (var recipe in capi.World.GridRecipes)
+                {
+                    if (!recipe.ShowInCreatedBy) continue;
+
+                    if (recipe.RecipeOutput?.ResolvedItemStack is { } outStack)
+                    {
+                        AddCandidate(outStack.Class, outStack.Id, recipe);
+                    }
+
+                    if (recipe.ResolvedIngredients != null)
+                    {
+                        foreach (var ingred in recipe.ResolvedIngredients)
+                        {
+                            if (ingred?.ReturnedStack?.ResolvedItemStack is { } rstack)
+                            {
+                                AddCandidate(rstack.Class, rstack.Id, recipe);
+                            }
+                        }
+                    }
+                }
+
+                return dict;
+            });
+        }
     }
