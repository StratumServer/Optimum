+        private bool UpdateOptimumVisualState()
+        {
+            int contentMode = (int)OvenContentMode;
+            int displayedItems = DisplayedItems;
+            int currentRotation = rotationDeg;
+            bool changed = !optimumHasVisualState
+                || optimumLastContentMode != contentMode
+                || optimumLastRotationDeg != currentRotation
+                || optimumLastSlotMeshKeys == null
+                || optimumLastSlotMeshKeys.Length != displayedItems
+                || optimumLastSlotHeightMuls == null
+                || optimumLastSlotHeightMuls.Length != displayedItems;
+
+            if (optimumLastSlotMeshKeys == null || optimumLastSlotMeshKeys.Length != displayedItems)
+            {
+                optimumLastSlotMeshKeys = new string[displayedItems];
+            }
+
+            if (optimumLastSlotHeightMuls == null || optimumLastSlotHeightMuls.Length != displayedItems)
+            {
+                optimumLastSlotHeightMuls = new float[displayedItems];
+            }
+
+            for (int i = 0; i < displayedItems; i++)
+            {
+                ItemSlot slot = i < Inventory.Count ? Inventory[i] : null;
+                string meshKey = (slot != null && !slot.Empty && slot.Itemstack?.Collectible?.Code != null)
+                    ? getMeshCacheKey(slot)
+                    : null;
+                float heightMul = (contentMode == (int)EnumOvenContentMode.Firewood)
+                    ? 0.9f
+                    : (i < bakingData.Length && bakingData[i] != null ? bakingData[i].CurHeightMul : 1f);
+
+                if (!string.Equals(optimumLastSlotMeshKeys[i], meshKey, StringComparison.Ordinal))
+                {
+                    optimumLastSlotMeshKeys[i] = meshKey;
+                    changed = true;
+                }
+
+                if (BitConverter.SingleToInt32Bits(optimumLastSlotHeightMuls[i]) != BitConverter.SingleToInt32Bits(heightMul))
+                {
+                    optimumLastSlotHeightMuls[i] = heightMul;
+                    changed = true;
+                }
+            }
+
+            optimumLastContentMode = contentMode;
+            optimumLastRotationDeg = currentRotation;
+            optimumHasVisualState = true;
+            return changed;
         }
 
