<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>VSEssentials</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>$(FrameworkVersion)</TargetFramework>
    <OutputPath>..\bin\$(Configuration)</OutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Configurations>Debug;Release;PerfTest</Configurations>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='PerfTest|AnyCPU'">
    <DefineConstants>TRACE;PERFTEST</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AnimatedGif" Version="1.0.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="protobuf-net" Version="2.4.9" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.1" />
    <PackageReference Include="OpenTK.Windowing.GraphicsLibraryFramework" Version="4.9.4" />
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <Reference Include="Tavis.JsonPatch">
      <HintPath>..\.vanilla\win-x64\vintagestory\Lib\Tavis.JsonPatch.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Exclude files not compiled by the upstream csproj (old-style explicit includes).
       BEAnimatable.cs / BEBehaviorCombinable.cs: superseded, not referenced by upstream's csproj.
       Loading/BlockLoader/*.cs: superseded by Loading/*.cs (BlockType.cs, CollectibleType.cs,
       ItemType.cs), not referenced by upstream's csproj; duplicate types if compiled alongside.
       Loading/EntityTypeLoader.cs, Loading/ItemAndBlockLoader.cs: superseded by
       RegistryObjectTypeLoader.cs, not referenced by upstream's csproj. -->
  <ItemGroup>
    <Compile Remove="BlockEntity\BEAnimatable.cs" />
    <Compile Remove="BlockEntityBehavior\BEBehaviorCombinable.cs" />
    <Compile Remove="Loading\BlockLoader\BlockType.cs" />
    <Compile Remove="Loading\BlockLoader\CollectibleType.cs" />
    <Compile Remove="Loading\BlockLoader\ItemType.cs" />
    <Compile Remove="Loading\EntityTypeLoader.cs" />
    <Compile Remove="Loading\ItemAndBlockLoader.cs" />
    <Compile Remove="Systems\WorldMap\ChunkLayer\OptimumBc7Support.cs" />
    <Compile Remove="Systems\WorldMap\ChunkLayer\OptimumMapLodGenerator.cs" />
    <Compile Remove="Systems\WorldMap\ChunkLayer\OptimumMapPageCache.cs" />
    <Compile Remove="Systems\WorldMap\ChunkLayer\OptimumMapPageRenderer.cs" />
    <Compile Remove="Systems\WorldMap\ChunkLayer\OptimumMapTextureArray.cs" />
    <Compile Remove="Systems\WorldMap\ChunkLayer\OptimumTerrainSampler.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cairo\Cairo.csproj" />
    <ProjectReference Include="..\optimum-api-contracts\optimum-api-contracts.csproj" />
    <ProjectReference Include="..\optimum-game-content\optimum-game-content.csproj" />
    <ProjectReference Include="..\VintagestoryApi\VintagestoryAPI.csproj" />
  </ItemGroup>
</Project>
