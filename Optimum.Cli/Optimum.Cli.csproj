<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Optimum.Cli</RootNamespace>
    <AssemblyName>optimum</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Description>Machine-readable front end for the Optimum installer engine. Emits the NDJSON protocol in INSTALLER-PLAN.md section 4. This is the binary RiftLauncher spawns.</Description>
    <Version>$(OptimumVersion)</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Optimum.Bootstrap.Core\Optimum.Bootstrap.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Optimum.Cli.Tests" />
  </ItemGroup>
</Project>
