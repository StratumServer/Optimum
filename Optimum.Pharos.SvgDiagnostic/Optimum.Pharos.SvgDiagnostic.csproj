<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == ''">$(VINTAGE_STORY)</VintageStoryPath>
    <PharosRoot Condition="'$(PharosRoot)' == ''">$(PHAROS_ROOT)</PharosRoot>
    <PharosRoot Condition="'$(PharosRoot)' == ''">../../Pharos</PharosRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <ProjectReference Include="$(PharosRoot)/src/Zaldaryon.Pharos/Zaldaryon.Pharos.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="VintagestoryAPI"><HintPath>$(VintageStoryPath)/VintagestoryAPI.dll</HintPath></Reference>
    <Reference Include="VintagestoryLib"><HintPath>$(VintageStoryPath)/VintagestoryLib.dll</HintPath></Reference>
    <Reference Include="Optimum.Api.Contracts"><HintPath>$(VintageStoryPath)/Optimum.Api.Contracts.dll</HintPath></Reference>
    <Reference Include="OpenTK.Graphics"><HintPath>$(VintageStoryPath)/Lib/OpenTK.Graphics.dll</HintPath></Reference>
    <Reference Include="OpenTK.Core"><HintPath>$(VintageStoryPath)/Lib/OpenTK.Core.dll</HintPath></Reference>
    <Reference Include="cairo-sharp"><HintPath>$(VintageStoryPath)/Lib/cairo-sharp.dll</HintPath></Reference>
    <Reference Include="SkiaSharp"><HintPath>$(VintageStoryPath)/Lib/SkiaSharp.dll</HintPath></Reference>
    <Content Include="$(VintageStoryPath)/Lib/*.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(VintageStoryPath)/Lib/*.so" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
