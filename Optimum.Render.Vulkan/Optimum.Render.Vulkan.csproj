<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Vulkan renderer backend. Referenced by nothing in the game: the
       launcher loads it reflectively and OptimumRenderBootstrap.CreatePlatform
       hands the client a VulkanClientPlatform, so no vanilla assembly ever gains
       an assembly reference to a renderer implementation. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Optimum.Render.Vulkan</AssemblyName>
    <RootNamespace>Optimum.Render.Vulkan</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>..\bin\$(Configuration)</OutputPath>
    <Nullable>annotations</Nullable>
    <!-- The packaging scripts copy this project's output beside the game, and
         nothing else in the tree references it, so its NuGet dependencies have
         to land in the output directory rather than being resolved from the
         referencing project's graph. Without this the backend loads and then
         fails on the first Silk.NET type. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\optimum-api-contracts\optimum-api-contracts.csproj" />
    <!-- The donor lib (Vulkan-native plan, Phase 1A): VulkanClientPlatform derives from
         ClientPlatformWindows, which only the donor declares unsealed with the injected
         virtuals. Compile-time only: at runtime the renderer binds to the Cecil-patched
         VintagestoryLib.dll already loaded by the client (same unsigned identity), so
         neither the lib nor anything it references is copied beside the renderer.
         ExcludeAssets and DisableTransitiveProjectReferences keep the lib's NuGet and
         project graph (fork VintagestoryAPI, OpenTK, SkiaSharp, Sqlite, ...) from flowing
         in: CopyLocalLockFileAssemblies above would otherwise copy all of it into the
         shared output that make deploy and the packagers read. -->
    <ProjectReference Include="..\build\VintagestoryLib\VintagestoryLib.csproj">
      <Private>false</Private>
      <ExcludeAssets>all</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The client already creates its window through OpenTK's GLFW bindings, so
         the surface is created the same way rather than through a second
         windowing stack. -->
    <PackageReference Include="OpenTK.Windowing.GraphicsLibraryFramework" Version="4.9.4" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
    <!-- Runtime GLSL to SPIR-V. Mod shaders are authored as GLSL and only exist
         at runtime, so an offline compile step could never cover them. -->
    <PackageReference Include="Silk.NET.Shaderc" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Shaderc.Native" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>..\.vanilla\win-x64\vintagestory\VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- VulkanClientPlatform overrides platform members whose signatures or bodies name
         types from the game's own libraries (Cairo surfaces, OpenAL version query,
         OpenTK PrimitiveType/Matrix4). Compile-time only: the client already loads them. -->
    <Reference Include="cairo-sharp">
      <HintPath>..\.vanilla\win-x64\vintagestory\Lib\cairo-sharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OpenTK.Audio.OpenAL">
      <HintPath>..\.vanilla\win-x64\vintagestory\Lib\OpenTK.Audio.OpenAL.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OpenTK.Windowing.Desktop">
      <HintPath>..\.vanilla\win-x64\vintagestory\Lib\OpenTK.Windowing.Desktop.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OpenTK.Windowing.Common">
      <HintPath>..\.vanilla\win-x64\vintagestory\Lib\OpenTK.Windowing.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OpenTK.Mathematics">
      <HintPath>..\.vanilla\win-x64\vintagestory\Lib\OpenTK.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OpenTK.Graphics">
      <HintPath>..\.vanilla\win-x64\vintagestory\Lib\OpenTK.Graphics.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Optimum.Render.Vulkan.Tests" />
  </ItemGroup>

  <!-- The NGX shim (native/optimum-ngx): the only call site NVIDIA's NGX
       accepts, because it resolves its caller's module from the return address
       and a .NET P/Invoke stub lives in anonymous JIT memory. Built with cc into
       bin/native and copied to this project's output like any content file, so
       it travels to the test host and to `make deploy` the same way the
       Silk.NET natives do.

       It degrades and never fails the solution build: with no compiler on the
       host build.sh prints one line and exits 0, no file appears, and the
       managed side reports NGX unavailable (NgxShim.Diagnosis says why).

       The Windows command carries the same -fno-optimize-sibling-calls that
       build.sh does, and for the same reason: a tail call pops the shim's frame,
       so NGX resolves the managed caller's module instead of the shim's and
       refuses. It creates bin/native first, because on a clean Windows checkout
       the directory does not exist yet and the link would fail with the shim's
       "no compiler" line covering for it. The mkdir is joined with & rather than
       && so an existing directory does not skip the compile.
       ContinueOnError covers the rest. -->
  <Target Name="BuildNgxShim" BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <NgxShimDir>$(MSBuildThisFileDirectory)../native/optimum-ngx</NgxShimDir>
      <NgxShimOut>$(MSBuildThisFileDirectory)../bin/native</NgxShimOut>
    </PropertyGroup>
    <Exec Condition="'$(OS)' != 'Windows_NT'"
          Command="bash &quot;$(NgxShimDir)/build.sh&quot; &quot;$(NgxShimOut)&quot;"
          ContinueOnError="true" />
    <Exec Condition="'$(OS)' == 'Windows_NT'"
          Command="if not exist &quot;$(NgxShimOut)&quot; mkdir &quot;$(NgxShimOut)&quot; &amp; where cc.exe &gt;nul 2&gt;&amp;1 &amp;&amp; cc.exe -std=c99 -O2 -fno-optimize-sibling-calls -shared &quot;$(NgxShimDir)/optimum_ngx.c&quot; -o &quot;$(NgxShimOut)/OptimumNgx.dll&quot; || echo optimum-ngx: the NGX shim was not built on this host; DLSS will report unavailable."
          ContinueOnError="true" />
    <ItemGroup>
      <None Include="$(NgxShimOut)/libOptimumNgx.so" Condition="Exists('$(NgxShimOut)/libOptimumNgx.so')">
        <Link>libOptimumNgx.so</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Include="$(NgxShimOut)/libOptimumNgx.dylib" Condition="Exists('$(NgxShimOut)/libOptimumNgx.dylib')">
        <Link>libOptimumNgx.dylib</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Include="$(NgxShimOut)/OptimumNgx.dll" Condition="Exists('$(NgxShimOut)/OptimumNgx.dll')">
        <Link>OptimumNgx.dll</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>
  </Target>

</Project>
