# Unified diffs must preserve whitespace from the exact decompiled baseline,
# including whitespace on removed lines, or they no longer apply faithfully.
*.patch text eol=lf -whitespace
*.cs text eol=lf
*.csproj text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.cmd text eol=lf
*.slnx text eol=lf
*.list text eol=lf
