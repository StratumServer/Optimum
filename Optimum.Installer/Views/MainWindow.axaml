<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="https://github.com/kikipoulet/SukiUI"
                 xmlns:vm="using:Optimum.Installer.ViewModels"
                 x:Class="Optimum.Installer.Views.MainWindow"
                 x:DataType="vm:MainWindowViewModel"
                 Width="920" Height="700"
                 MinWidth="840" MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 CanFullScreen="False"
                 BackgroundStyle="Flat"
                 BackgroundAnimationEnabled="False"
                 TextOptions.TextRenderingMode="Antialias"
                 FontFamily="{StaticResource BodyFont}"
                 Title="{Binding Title}">

  <suki:SukiWindow.LogoContent>
    <Border Width="22" Height="22" CornerRadius="4" VerticalAlignment="Center"
            Background="{DynamicResource SukiPrimaryColor}">
      <TextBlock Text="O" FontSize="13" FontWeight="SemiBold"
                 Foreground="White"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
  </suki:SukiWindow.LogoContent>

  <Grid ColumnDefinitions="216,*">

    <!-- Step rail -->
    <Border Grid.Column="0" Padding="24,28"
            Background="{DynamicResource SukiCardBackground}">
      <suki:VerticalStepper Index="{Binding StepIndex}" Steps="{Binding StepLabels}"
                            VerticalAlignment="Top" />
    </Border>

    <!-- Content column -->
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="32,26,32,26">
      <StackPanel Grid.Row="0" Spacing="4" IsVisible="{Binding HeaderVisible}">
        <TextBlock Text="{Binding CurrentStepLabel}" Classes="eyebrow Primary" />
        <TextBlock Text="{Binding CurrentStepTitle}" Classes="h3" />
        <TextBlock Text="{Binding CurrentStepDescription}" Classes="Caption"
                   TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                   Margin="0,2,0,0" />
      </StackPanel>

      <suki:GlassCard Grid.Row="1" Margin="0,16,0,0" Padding="16,12"
                      IsVisible="{Binding UpdatePromptVisible}">
        <StackPanel DataContext="{Binding UpdateBanner}" Spacing="8">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Grid.Column="0" Text="{Binding Message}" VerticalAlignment="Center"
                       TextWrapping="Wrap" FontWeight="SemiBold" Classes="Warning" />
            <Button Grid.Column="1" Content="Update now" Classes="Flat" Margin="10,0,0,0"
                    IsEnabled="{Binding !Updating}" Command="{Binding UpdateCommand}" />
            <Button Grid.Column="2" Content="Later" Classes="Basic" Margin="6,0,0,0"
                    IsEnabled="{Binding !Updating}" Command="{Binding DismissCommand}" />
          </Grid>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" IsVisible="{Binding Updating}" />
          <TextBlock Text="{Binding Error}" Classes="Danger" FontSize="14" TextWrapping="Wrap"
                     IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </suki:GlassCard>

      <suki:SukiTransitioningContentControl Grid.Row="2" Content="{Binding CurrentViewModel}"
                                            Margin="0,20,0,0" />
    </Grid>
  </Grid>
</suki:SukiWindow>
