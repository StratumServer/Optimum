<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Optimum.Installer.ViewModels"
        xmlns:views="using:Optimum.Installer.Views"
        x:Class="Optimum.Installer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="960" Height="800"
        CanResize="True"
        WindowState="Maximized"
        Icon="avares://Optimum.Installer/Assets/optimum-logo.png"
        Title="{Binding Title}">

  <Grid x:Name="RootLayout" ColumnDefinitions="200,*">

    <!-- Step rail: a standard navigation column tinted with the Fluent layer
         brush. Each row shows a numbered marker and its label; the marker fills
         with the system accent once the step is reached, and a check replaces
         the number once it is done. Foregrounds bind through the visual tree
         (DynamicResource) so they resolve against the live Fluent theme. -->
    <Border Grid.Column="0" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
      <ItemsControl ItemsSource="{Binding Steps}" VerticalAlignment="Top" Margin="20,28">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:WizardStep">
            <Grid ColumnDefinitions="32,*" Height="48" Margin="0,2">
              <!-- Marker: filled accent when reached, hollow outline when upcoming. -->
              <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15" VerticalAlignment="Center"
                      Background="{Binding IsReached, Converter={x:Static views:InstallerConverters.StepCircleBrush}}"
                      BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                      BorderThickness="{Binding IsReached, Converter={x:Static views:InstallerConverters.StepCircleBorder}}">
                <Panel>
                  <TextBlock Text="{Binding Number}" FontSize="13" FontWeight="SemiBold"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                             IsVisible="{Binding IsCurrent}" />
                  <TextBlock Text="{Binding Number}" FontSize="13" FontWeight="SemiBold"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             IsVisible="{Binding !IsReached}" />
                  <PathIcon Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                            Width="13" Height="13"
                            Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsVisible="{Binding IsDone}" />
                </Panel>
              </Border>
              <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="14,0,0,0"
                         FontSize="14" TextWrapping="Wrap"
                         FontWeight="{Binding IsCurrent, Converter={x:Static views:InstallerConverters.StepWeight}}"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <Grid x:Name="ContentLayout" Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="28,20,28,20">
      <StackPanel Grid.Row="0" Spacing="2" IsVisible="{Binding HeaderVisible}">
        <TextBlock Text="{Binding CurrentStepLabel}" FontWeight="SemiBold"
                   FontSize="13"
                   Foreground="{DynamicResource SystemAccentColorLight1}" />
        <TextBlock x:Name="CurrentStepTitle" Text="{Binding CurrentStepTitle}" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="{Binding CurrentStepDescription}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" />
      </StackPanel>

      <Border Grid.Row="1" Classes="Card" Margin="0,14,0,0" IsVisible="{Binding UpdatePromptVisible}">
        <StackPanel DataContext="{Binding UpdateBanner}" Spacing="10">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Grid.Column="0" Text="{Binding Message}"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" />
            <Button Grid.Column="1" Content="Update now" Classes="accent" Margin="10,0,0,0"
                    IsEnabled="{Binding !Updating}" Command="{Binding UpdateCommand}" />
            <Button Grid.Column="2" Content="Later" Margin="8,0,0,0"
                    IsEnabled="{Binding !Updating}" Command="{Binding DismissCommand}" />
          </Grid>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" IsVisible="{Binding Updating}" />
          <TextBlock Text="{Binding Error}"
                     Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                     IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <!-- Fade between steps, unless the OS asks for reduced motion. -->
      <TransitioningContentControl Grid.Row="2" Content="{Binding CurrentViewModel}"
                                   Margin="0,12,0,0"
                                   IsVisible="{x:Static views:MotionSettings.AllowMotion}" />
      <ContentControl Grid.Row="2" Content="{Binding CurrentViewModel}" Margin="0,12,0,0"
                      IsVisible="{x:Static views:MotionSettings.ReduceMotion}" />
    </Grid>
  </Grid>
</Window>
