<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Optimum.Installer.ViewModels"
        x:Class="Optimum.Installer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="760" Height="560"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Title="{Binding Title}">
  <Panel>
    <DockPanel Margin="24">
      <TextBlock DockPanel.Dock="Top" Text="Optimum installer"
                 FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />

      <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="12,8"
              Background="{DynamicResource SystemAccentColorLight2}" CornerRadius="4"
              IsVisible="{Binding UpdateBanner, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Grid ColumnDefinitions="*,Auto,Auto" DataContext="{Binding UpdateBanner}"
              IsVisible="{Binding !Dismissed}">
          <TextBlock Grid.Column="0" Text="{Binding Message}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Update now" Margin="8,0,0,0"
                  IsEnabled="{Binding !Updating}" Command="{Binding UpdateCommand}" />
          <Button Grid.Column="2" Content="Later" Margin="8,0,0,0"
                  Command="{Binding DismissCommand}" />
        </Grid>
      </Border>

      <ContentControl Content="{Binding CurrentViewModel}" />
    </DockPanel>

    <Border IsVisible="{Binding IsEulaOpen}" Background="#99000000">
      <Border Background="{DynamicResource ThemeBackgroundBrush}"
              CornerRadius="6" Padding="20" Margin="60"
              MaxWidth="560" MaxHeight="460"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <ContentControl Content="{Binding Eula}" />
      </Border>
    </Border>
  </Panel>
</Window>
