<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:vm="using:Optimum.Installer.ViewModels"
             xmlns:conv="using:Optimum.Installer.Views"
             x:Class="Optimum.Installer.Views.ProgressView"
             x:DataType="vm:ProgressViewModel">
  <Grid RowDefinitions="Auto,*,Auto">

    <suki:GlassCard Grid.Row="0" Padding="18">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="{Binding PhaseLabel}" Classes="h5" />
            <TextBlock Text="{Binding StatusDetail}" Classes="Caption"
                       TextWrapping="Wrap"
                       IsVisible="{Binding StatusDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding PercentLabel}" Classes="h2"
                     VerticalAlignment="Center" Margin="16,0,0,0" />
        </Grid>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="6"
                     AutomationProperties.Name="Installation progress" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="Runs locally. The first build takes the longest."
                     Classes="Caption" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
            <TextBlock Classes="Caption">
              <Run Text="Elapsed " /><Run Text="{Binding Elapsed}" />
            </TextBlock>
            <TextBlock Text="{Binding EstimatedRemaining}" Classes="Caption"
                       IsVisible="{Binding EstimatedRemaining, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </suki:GlassCard>

    <Expander Grid.Row="1" Header="Build log" Margin="0,12,0,0"
              HorizontalAlignment="Stretch">
      <Border Height="220">
        <ScrollViewer x:Name="LogScroller" Padding="4,8">
          <ItemsControl ItemsSource="{Binding Log}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LogLine">
                <TextBlock Text="{Binding Text}" FontFamily="monospace" FontSize="11.5"
                           LineHeight="16"
                           Foreground="{Binding Level, Converter={x:Static conv:InstallerConverters.LogLevelBrush}}"
                           TextWrapping="Wrap" Margin="0,1.5" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </Expander>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
      <suki:GlassCard Grid.Column="0" Padding="12,9" Margin="0,0,12,0"
                      IsVisible="{Binding ConfirmCancel}">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="Stop the installation?" Classes="Warning"
                     FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Content="Keep going" Classes="Basic" Command="{Binding KeepInstallingCommand}" />
          <Button Content="Stop" Classes="Danger" Command="{Binding CancelCommand}" />
        </StackPanel>
      </suki:GlassCard>
      <Button Grid.Column="1" Content="Cancel" Classes="Basic"
              IsEnabled="{Binding !CancelRequested}"
              IsVisible="{Binding !ConfirmCancel}"
              Command="{Binding RequestCancelCommand}" />
    </Grid>
  </Grid>
</UserControl>
