<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:vm="using:Optimum.Installer.ViewModels"
             xmlns:conv="using:Optimum.Installer.Views"
             x:Class="Optimum.Installer.Views.ProgressView"
             x:DataType="vm:ProgressViewModel">
  <Grid RowDefinitions="Auto,*,Auto">

    <suki:GlassCard Grid.Row="0" Padding="20,18">
      <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
        <Panel Grid.Column="0" Width="84" Height="84" Margin="0,0,22,0" VerticalAlignment="Center">
          <suki:CircleProgressBar Value="{Binding Percent}" StrokeWidth="7" Width="84" Height="84" />
          <TextBlock Text="{Binding PercentLabel}" FontWeight="DemiBold" FontSize="18"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Panel>

        <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
          <TextBlock Text="{Binding PhaseLabel}" Classes="h5" />
          <TextBlock Text="{Binding StatusDetail}" Classes="Caption" TextWrapping="Wrap"
                     IsVisible="{Binding StatusDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <Grid ColumnDefinitions="*,Auto" Margin="0,3,0,0">
            <TextBlock Grid.Column="0" Text="Runs locally. The first build takes the longest." Classes="Caption"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
              <TextBlock Classes="Caption">
                <Run Text="Elapsed " /><Run Text="{Binding Elapsed}" FontFamily="{DynamicResource MonoFont}" />
              </TextBlock>
              <TextBlock Text="{Binding EstimatedRemaining}" Classes="Caption"
                         IsVisible="{Binding EstimatedRemaining, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Grid>
    </suki:GlassCard>

    <suki:GlassCard Grid.Row="1" Margin="0,12,0,0" Padding="0">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="Build log" Classes="h5" Margin="16,14,16,8" />
        <Border Grid.Row="1" Background="{DynamicResource InsetSurfaceBrush}"
                BorderBrush="{DynamicResource InsetBorderBrush}" BorderThickness="0,1,0,0"
                CornerRadius="0,0,12,12">
          <ScrollViewer x:Name="LogScroller" Padding="16,10">
            <ItemsControl ItemsSource="{Binding Log}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LogLine">
                  <TextBlock Text="{Binding Text}" FontFamily="{DynamicResource MonoFont}" FontSize="13"
                             Foreground="{Binding Level, Converter={x:Static conv:InstallerConverters.LogLevelBrush}}"
                             TextWrapping="Wrap" Margin="0,1.5" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Grid>
    </suki:GlassCard>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
      <suki:GlassCard Grid.Column="0" Margin="0,0,12,0" IsVisible="{Binding ConfirmCancel}">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="Stop the installation?" Classes="Warning" FontWeight="DemiBold"
                     VerticalAlignment="Center" />
          <Button Content="Keep going" Command="{Binding KeepInstallingCommand}" />
          <Button Content="Stop" Classes="Flat" Command="{Binding CancelCommand}" />
        </StackPanel>
      </suki:GlassCard>
      <Button Grid.Column="1" Content="Cancel"
              IsEnabled="{Binding !CancelRequested}"
              IsVisible="{Binding !ConfirmCancel}"
              Command="{Binding RequestCancelCommand}" />
    </Grid>
  </Grid>
</UserControl>
