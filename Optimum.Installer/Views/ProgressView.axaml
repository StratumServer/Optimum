<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Optimum.Installer.ViewModels"
             xmlns:conv="using:Optimum.Installer.Views"
             x:Class="Optimum.Installer.Views.ProgressView"
             x:DataType="vm:ProgressViewModel">
  <Grid RowDefinitions="Auto,*,Auto">

    <Border Classes="Card" Grid.Row="0" Padding="20,18">
      <StackPanel x:Name="ProgressText" Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding PhaseLabel}" FontSize="17" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding PercentLabel}" FontSize="17" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </Grid>
        <!-- WinUI-styled indeterminate progress bar. -->
        <ProgressBar IsIndeterminate="True" Height="4" />
        <TextBlock Text="{Binding StatusDetail}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                   IsVisible="{Binding StatusDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <StackPanel Spacing="4" Margin="0,3,0,0">
          <TextBlock Text="Runs locally. The first build takes the longest."
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
          <WrapPanel>
            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}">
              <Run Text="Elapsed " /><Run Text="{Binding Elapsed}" FontFamily="Cascadia Code, Consolas, monospace" />
            </TextBlock>
            <TextBlock Text="{Binding EstimatedRemaining}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="14,0,0,0"
                       IsVisible="{Binding EstimatedRemaining, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </WrapPanel>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="Card" Grid.Row="1" Margin="0,12,0,0" Padding="0">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="Build log" FontSize="17" FontWeight="SemiBold" Margin="16,14,16,8" />
        <Border Grid.Row="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                CornerRadius="0,0,8,8">
          <ScrollViewer x:Name="LogScroller" Padding="16,10">
            <ItemsControl ItemsSource="{Binding Log}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LogLine">
                  <TextBlock Text="{Binding Text}" FontFamily="Cascadia Code, Consolas, monospace" FontSize="13"
                             Foreground="{Binding Level, Converter={x:Static conv:InstallerConverters.LogLevelBrush}}"
                             TextWrapping="Wrap" Margin="0,1.5" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
      <Border Classes="Card" Grid.Column="0" Margin="0,0,12,0" IsVisible="{Binding ConfirmCancel}">
        <StackPanel Spacing="8">
          <TextBlock Text="Stop the installation?"
                     Foreground="{DynamicResource SystemFillColorCautionBrush}" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <WrapPanel>
            <Button Content="Keep going" Command="{Binding KeepInstallingCommand}" Margin="0,0,8,0" />
            <Button Content="Stop" Classes="accent" Command="{Binding CancelCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Button Grid.Column="1" Content="Cancel"
              IsEnabled="{Binding !CancelRequested}"
              IsVisible="{Binding !ConfirmCancel}"
              Command="{Binding RequestCancelCommand}" />
    </Grid>
  </Grid>
</UserControl>
