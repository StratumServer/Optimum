<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Optimum.Installer.ViewModels"
             x:Class="Optimum.Installer.Views.PrerequisitesView"
             x:DataType="vm:PrerequisitesViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border Grid.Row="0" Classes="subtleCard" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="3">
          <TextBlock Text="System status" Classes="sectionTitle" />
          <TextBlock Text="{Binding Summary}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Content="Check again" Margin="16,0,0,0"
                VerticalAlignment="Center" Command="{Binding RescanCommand}"
                AutomationProperties.Name="Check system requirements again" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Classes="card" Margin="0,0,0,12"
            IsVisible="{Binding RepoRootMissing}">
      <StackPanel Spacing="10">
        <StackPanel Spacing="3">
          <TextBlock Text="Optimum source" Classes="sectionTitle" />
          <TextBlock Text="The installer downloads the matching public Optimum source into your user cache. Vintage Story files are obtained later on this computer and are never included in the installer."
                     Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Content="Download Optimum source" Classes="accent"
                  IsVisible="{Binding CanAcquireSource}"
                  IsEnabled="{Binding !AcquiringSource}"
                  Command="{Binding AcquireSourceCommand}" />
          <ProgressBar IsIndeterminate="True" Width="120" Height="6"
                       IsVisible="{Binding AcquiringSource}"
                       AutomationProperties.Name="Downloading Optimum source" />
          <TextBlock Text="{Binding SourceStatus}" Classes="muted"
                     VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Classes="card" Padding="0">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Rows}" Margin="8">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PrerequisiteRowViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="8" MinHeight="54">
                <Grid Grid.Column="0" Width="104" VerticalAlignment="Center" Margin="0,0,12,0">
                  <Border IsVisible="{Binding IsReady}" CornerRadius="12" Padding="10,4"
                          Background="{DynamicResource AppSuccessSurfaceBrush}">
                    <TextBlock Text="Ready" Foreground="{DynamicResource AppSuccessBrush}"
                               FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  </Border>
                  <Border IsVisible="{Binding IsOptional}" CornerRadius="12" Padding="10,4"
                          Background="{DynamicResource AppSurfaceSubtleBrush}">
                    <TextBlock Text="Optional" Classes="muted"
                               FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  </Border>
                  <Border IsVisible="{Binding NeedsAttention}" CornerRadius="12" Padding="10,4"
                          Background="{DynamicResource AppWarningSurfaceBrush}">
                    <TextBlock Text="{Binding StatusLabel}" Foreground="{DynamicResource AppWarningBrush}"
                               FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  </Border>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12"
                             TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2" Content="{Binding ActionLabel}" Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        IsVisible="{Binding ActionLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Command="{Binding ActionCommand}"
                        ToolTip.Tip="{Binding ActionDetail}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
      <Button Content="Continue to options" Classes="accent"
              IsEnabled="{Binding CanContinue}"
              Command="{Binding ContinueCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
