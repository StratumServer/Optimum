<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Optimum.Installer.ViewModels"
             xmlns:conv="using:Optimum.Installer.Views"
             x:Class="Optimum.Installer.Views.PrerequisitesView"
             x:DataType="vm:PrerequisitesViewModel">
  <Grid RowDefinitions="Auto,*,Auto">

    <Grid Grid.Row="0" RowDefinitions="Auto,Auto" Margin="0,0,0,12">
      <TextBlock Grid.Row="0" Text="{Binding Summary}" TextWrapping="Wrap" />
      <Button Grid.Row="1" Content="Check again" Margin="0,8,0,0"
              HorizontalAlignment="Right" Command="{Binding RescanCommand}"
              AutomationProperties.Name="Check system requirements again" />
    </Grid>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12">

        <Border Classes="Card" IsVisible="{Binding RepoRootMissing}">
          <StackPanel Spacing="10">
            <TextBlock Text="Optimum source" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="The matching public Optimum source is downloaded into your user cache. Vintage Story files are fetched later on this computer and are never bundled with the installer."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <WrapPanel>
              <Button Content="Download source" Classes="accent"
                      IsVisible="{Binding CanAcquireSource}"
                      IsEnabled="{Binding !AcquiringSource}"
                      Command="{Binding AcquireSourceCommand}" Margin="0,0,12,8" />
              <ProgressBar IsIndeterminate="True" Width="130" Height="4"
                           IsVisible="{Binding AcquiringSource}"
                           AutomationProperties.Name="Downloading Optimum source" Margin="0,8,12,8" />
              <TextBlock Text="{Binding SourceStatus}"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         VerticalAlignment="Center" TextWrapping="Wrap" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding AttentionRows}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PrerequisiteRowViewModel">
              <Border Classes="Card">
                <StackPanel Spacing="8">
                  <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold"
                                 Foreground="{Binding IsOptional, Converter={x:Static conv:InstallerConverters.StatusBrush}}"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Detail}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <SelectableTextBlock Text="{Binding ManualCommand}"
                                         FontFamily="Cascadia Code, Consolas, monospace"
                                         IsVisible="{Binding ManualCommand, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding ConfirmationDetail}" IsVisible="{Binding AwaitingConfirmation}"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                  <WrapPanel>
                    <Button Content="{Binding ActionLabel}" Classes="accent"
                            IsVisible="{Binding ActionLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            IsEnabled="{Binding CanRequestInstall}"
                            Command="{Binding ActionCommand}"
                            ToolTip.Tip="{Binding ActionDetail}" Margin="0,0,8,8" />
                    <Button Content="Confirm and install" Classes="accent"
                            IsVisible="{Binding AwaitingConfirmation}"
                            Command="{Binding ConfirmInstallCommand}" Margin="0,0,8,8" />
                    <Button Content="Not now" IsVisible="{Binding AwaitingConfirmation}"
                            Margin="0,0,8,8"
                            Command="{Binding CancelConfirmationCommand}" />
                    <Button Content="Cancel installation" IsVisible="{Binding CanCancelInstall}"
                            Command="{Binding CancelInstallCommand}" Margin="0,0,8,8" />
                    <Button Content="{Binding ManualFallbackLabel}"
                            IsVisible="{Binding ManualFallbackLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Command="{Binding ManualDownloadCommand}" Margin="0,0,8,8" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="Card" IsVisible="{Binding HasReadyTools}">
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0" Text="&#x2713;" FontWeight="Bold"
                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                       FontSize="18" Margin="0,0,12,0" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="System tools ready" FontWeight="SemiBold" />
              <SelectableTextBlock Text="{Binding ReadySummary}" TextWrapping="Wrap"
                                   FontFamily="Cascadia Code, Consolas, monospace" />
            </StackPanel>
          </Grid>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Continue" Classes="accent"
              IsEnabled="{Binding CanContinue}"
              Command="{Binding ContinueCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
