<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:vm="using:Optimum.Installer.ViewModels"
             xmlns:conv="using:Optimum.Installer.Views"
             x:Class="Optimum.Installer.Views.PrerequisitesView"
             x:DataType="vm:PrerequisitesViewModel">
  <Grid RowDefinitions="Auto,*,Auto">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <TextBlock Grid.Column="0" Text="{Binding Summary}" Classes="Caption"
                 TextWrapping="Wrap" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Check again" Classes="Basic" Margin="16,0,0,0"
              VerticalAlignment="Center" Command="{Binding RescanCommand}"
              AutomationProperties.Name="Check system requirements again" />
    </Grid>

    <!-- The row list can grow past the window on a bare machine, so it scrolls
         while the summary above and the Continue button below stay pinned. -->
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="10">

        <suki:GlassCard Padding="16" IsVisible="{Binding RepoRootMissing}">
          <StackPanel Spacing="12">
            <StackPanel Spacing="3">
              <TextBlock Text="Optimum source" Classes="h5" />
              <TextBlock Text="The matching public Optimum source is downloaded into your user cache. Vintage Story files are fetched later on this computer and are never bundled with the installer."
                         Classes="Caption" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <Button Content="Download source" Classes="Flat"
                      IsVisible="{Binding CanAcquireSource}"
                      IsEnabled="{Binding !AcquiringSource}"
                      Command="{Binding AcquireSourceCommand}" />
              <ProgressBar IsIndeterminate="True" Width="130" Height="4"
                           IsVisible="{Binding AcquiringSource}"
                           AutomationProperties.Name="Downloading Optimum source" />
              <TextBlock Text="{Binding SourceStatus}" Classes="Caption"
                         VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </suki:GlassCard>

        <!-- Only the tools that need a decision. Everything already in place is
             the one line below. -->
        <ItemsControl ItemsSource="{Binding AttentionRows}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PrerequisiteRowViewModel">
              <suki:GlassCard Padding="16,13">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,7,13,0"
                           VerticalAlignment="Top"
                           Fill="{Binding IsOptional, Converter={x:Static conv:InstallerConverters.OptionalOrBlockingDot}}" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding StatusLabel}" Classes="Caption" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Detail}" Classes="Caption" TextWrapping="Wrap" />
                    <SelectableTextBlock Text="{Binding ManualCommand}"
                                         FontFamily="{StaticResource MonoFont}" FontSize="13" Margin="0,3,0,0"
                                         IsVisible="{Binding ManualCommand, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                  <Button Grid.Column="2" Content="{Binding ActionLabel}" Classes="Flat" Margin="14,0,0,0"
                          VerticalAlignment="Center"
                          IsVisible="{Binding ActionLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                          Command="{Binding ActionCommand}"
                          ToolTip.Tip="{Binding ActionDetail}" />
                </Grid>
              </suki:GlassCard>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <suki:GlassCard Padding="14,11" IsVisible="{Binding HasReadyTools}">
          <Grid ColumnDefinitions="Auto,*">
            <Ellipse Grid.Column="0" Width="18" Height="18" Margin="0,1,10,0" VerticalAlignment="Top"
                     Fill="{DynamicResource SukiSuccessColor}" />
            <TextBlock Grid.Column="0" Text="&#x2713;" Foreground="White" FontWeight="Bold" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,1,10,0" Width="18" TextAlignment="Center"
                       VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="{Binding ReadySummary}" Classes="Caption" TextWrapping="Wrap" />
          </Grid>
        </suki:GlassCard>

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Continue" Classes="Flat"
              IsEnabled="{Binding CanContinue}"
              Command="{Binding ContinueCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
