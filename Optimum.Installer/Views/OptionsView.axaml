<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Optimum.Installer.ViewModels"
             x:Class="Optimum.Installer.Views.OptionsView"
             x:DataType="vm:OptionsViewModel">
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0">
      <StackPanel Spacing="12">

        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="Install location" Classes="sectionTitle" />
            <TextBox Text="{Binding InstallDirectory}" PlaceholderText="Install directory"
                     AutomationProperties.Name="Install directory" TabIndex="1" />
            <TextBlock Text="An empty folder you own. Optimum is built in a temporary workspace and moved here when it is ready."
                       Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="Game data" Classes="sectionTitle" />
            <CheckBox Content="Use a separate Vintage Story data folder"
                      IsChecked="{Binding UseSeparateDataFolder}" TabIndex="2" />
            <TextBlock Text="Off: Optimum shares Vintage Story's settings, worlds, and signed-in session. On: it keeps its own."
                       Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
            <StackPanel Spacing="5" IsVisible="{Binding UseSeparateDataFolder}">
              <TextBox Text="{Binding DataPath}" PlaceholderText="Vintage Story data folder"
                       AutomationProperties.Name="Vintage Story data folder" TabIndex="3" />
              <TextBlock Text="{Binding DataPathHint}" Classes="muted" FontSize="12"
                         TextWrapping="Wrap"
                         IsVisible="{Binding DataPathHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="9">
              <TextBlock Text="Shortcuts" Classes="sectionTitle" />
              <CheckBox Content="Add an application menu entry"
                        IsChecked="{Binding CreateMenuEntry}" TabIndex="4" />
              <CheckBox Content="Create a desktop shortcut"
                        IsChecked="{Binding CreateDesktopShortcut}" TabIndex="5" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="7" Width="240" Margin="24,0,0,0"
                        IsVisible="{Binding ShowVersionChoice}">
              <TextBlock Text="Vintage Story version" Classes="sectionTitle" />
              <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Vintage Story version" TabIndex="6" />
              <TextBlock Text="Use the recommended version unless you need a compatibility bridge."
                         Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Background="{DynamicResource AppDangerSurfaceBrush}"
                BorderBrush="{DynamicResource AppDangerBrush}" BorderThickness="1"
                CornerRadius="4" Padding="12"
                IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding ValidationError}" Foreground="{DynamicResource AppDangerBrush}"
                     TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
      <Button Grid.Column="0" Content="Back" Classes="ghost"
              Command="{Binding BackCommand}" TabIndex="8" />
      <Button Grid.Column="2" Content="Review" Classes="accent"
              IsEnabled="{Binding CanContinue}" Command="{Binding ContinueCommand}" TabIndex="7" />
    </Grid>
  </Grid>
</UserControl>
