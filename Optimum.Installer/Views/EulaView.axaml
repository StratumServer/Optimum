<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Optimum.Installer.ViewModels"
             x:Class="Optimum.Installer.Views.EulaView"
             x:DataType="vm:EulaViewModel">
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0" x:Name="Scroller" ScrollChanged="OnScrollChanged"
                  HorizontalScrollBarVisibility="Disabled"
                  AutomationProperties.Name="Install summary and Optimum build notice">
      <StackPanel Spacing="12">
        <Border Classes="Card">
          <StackPanel Spacing="10">
            <TextBlock Text="Summary" FontSize="17" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
              <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" Margin="0,0,16,12">
                <TextBlock Text="Install to" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding InstallDirectory}" TextWrapping="Wrap" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2" Margin="0,0,0,12">
                <TextBlock Text="Game data" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding DataPathSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Version" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding VersionSummary}" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                <TextBlock Text="Shortcuts" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding ShortcutSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="Card" Padding="0">
          <StackPanel Spacing="8">
            <TextBlock Text="Build notice" FontSize="17" FontWeight="SemiBold" Margin="16,14,16,0" />
            <TextBlock Margin="16,0,16,0"
                       Text="Optimum is compiled from your own Vintage Story installation. Read to the end to continue."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8">
              <TextBlock Text="{Binding ConsentText}" TextWrapping="Wrap" Margin="16,12" />
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Spacing="10" Margin="0,12,0,0">
      <CheckBox Content="I have read and accept this notice"
                IsChecked="{Binding Accepted}" x:Name="AcceptBox" TabIndex="1" />
      <TextBlock Text="{Binding ScrollHint}"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      <WrapPanel HorizontalAlignment="Right">
        <Button Content="Back" Margin="0,0,8,0"
                Command="{Binding DeclineCommand}" TabIndex="2" />
        <Button Content="Start install" Classes="accent"
                IsEnabled="{Binding CanAccept}" Command="{Binding AcceptCommand}" TabIndex="3" />
      </WrapPanel>
    </StackPanel>
  </Grid>
</UserControl>
