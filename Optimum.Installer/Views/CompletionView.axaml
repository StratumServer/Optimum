<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Optimum.Installer.ViewModels"
             x:Class="Optimum.Installer.Views.CompletionView"
             x:DataType="vm:CompletionViewModel">
  <StackPanel Spacing="12" VerticalAlignment="Center">
    <TextBlock Text="{Binding Headline}" FontSize="18" FontWeight="SemiBold" />
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding InstallDirectory}" Opacity="0.7" FontSize="12"
               IsVisible="{Binding InstallDirectory, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Launch Optimum" Classes="accent"
              IsVisible="{Binding Succeeded}"
              Command="{Binding LaunchCommand}" />
      <Button Content="Try again"
              IsVisible="{Binding CanRetry}"
              Command="{Binding RetryCommand}" />
      <Button Content="View log"
              IsVisible="{Binding !Succeeded}"
              Command="{Binding ViewLogCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>
