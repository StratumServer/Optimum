<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Optimum.Installer.ViewModels"
             xmlns:conv="using:Optimum.Installer.Views"
             x:Class="Optimum.Installer.Views.CompletionView"
             x:DataType="vm:CompletionViewModel">
  <Grid RowDefinitions="*,Auto,*">
    <StackPanel Grid.Row="1" Spacing="16" MaxWidth="520" HorizontalAlignment="Left">

      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border Width="30" Height="30" CornerRadius="4" VerticalAlignment="Center"
                Background="{Binding Succeeded, Converter={x:Static conv:InstallerConverters.OutcomeSurface}}">
          <TextBlock Text="{Binding Succeeded, Converter={x:Static conv:InstallerConverters.OutcomeGlyph}}"
                     FontWeight="Bold" FontSize="15"
                     Foreground="{Binding Succeeded, Converter={x:Static conv:InstallerConverters.OutcomeInk}}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="{Binding Headline}" Classes="display" VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock Text="{Binding Subtext}" Classes="muted" TextWrapping="Wrap" />

      <Border Classes="subtleCard"
              IsVisible="{Binding InstallDirectory, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <StackPanel Spacing="2">
          <TextBlock Text="INSTALLED AT" Classes="fieldLabel" />
          <TextBlock Text="{Binding InstallDirectory}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12.5" />
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
        <Button Content="Launch Optimum" Classes="accent"
                IsVisible="{Binding Succeeded}" IsEnabled="{Binding CanLaunch}"
                Command="{Binding LaunchCommand}" />
        <Button Content="Try again" Classes="accent"
                IsVisible="{Binding CanRetry}" Command="{Binding RetryCommand}" />
        <Button Content="Open log" Classes="ghost"
                IsVisible="{Binding ShowLog}" Command="{Binding ViewLogCommand}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
