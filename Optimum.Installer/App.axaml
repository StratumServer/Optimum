<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:local="using:Optimum.Installer"
             x:Class="Optimum.Installer.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <FontFamily x:Key="BodyFont">avares://Optimum.Installer/Assets/Fonts/Figtree/Figtree-VF.ttf#Figtree</FontFamily>
    <FontFamily x:Key="DisplayFont">avares://Optimum.Installer/Assets/Fonts/Fraunces/Fraunces.ttf#Fraunces</FontFamily>
    <FontFamily x:Key="MonoFont">avares://Optimum.Installer/Assets/Fonts/GeistMono/GeistMono-VF.ttf#Geist Mono</FontFamily>
  </Application.Resources>

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <suki:SukiTheme ThemeColor="Orange" />

    <!-- Accessibility-first type scale. Body is 18px Medium with a 1.6 line
         height and full-strength ink; nothing readable drops below 15, click
         targets are >= 44px. Figtree for text, Fraunces for display. -->
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="LineHeight" Value="29" />
      <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
    </Style>
    <Style Selector="SelectableTextBlock">
      <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="LineHeight" Value="29" />
      <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
    </Style>

    <!-- Lede: the important context line under a heading. Full body size,
         a touch softer than the headline ink but still high contrast. -->
    <Style Selector="TextBlock.lede">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="LineHeight" Value="28" />
      <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
    </Style>

    <!-- Genuine secondary copy: 16, and #555 rather than the faint control
         grey so it still passes contrast comfortably. -->
    <Style Selector="TextBlock.Caption">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="LineHeight" Value="24" />
      <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
    </Style>

    <!-- Uppercase eyebrow labels ("STEP 1 OF 4", "INSTALL TO"). -->
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1" />
    </Style>

    <!-- Section title inside a card. -->
    <Style Selector="TextBlock.h5">
      <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
      <Setter Property="FontSize" Value="21" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LineHeight" Value="28" />
    </Style>

    <!-- Progress percentage readout. -->
    <Style Selector="TextBlock.h2">
      <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
      <Setter Property="FontSize" Value="42" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LineHeight" Value="48" />
    </Style>

    <!-- Page title. -->
    <Style Selector="TextBlock.h3">
      <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
      <Setter Property="FontSize" Value="33" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LineHeight" Value="42" />
    </Style>

    <!-- Buttons and inputs: 17px text, 44px min height (touch target). The
         window-chrome buttons are excluded: SukiWindow sizes those itself. -->
    <Style Selector="Button:not(.WindowControlsButton)">
      <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="20,10" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="CheckBox /template/ ContentPresenter">
      <Setter Property="TextBlock.FontSize" Value="17" />
    </Style>

    <!-- Monospace log lines. -->
    <Style Selector="TextBlock.log">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="LineHeight" Value="21" />
    </Style>

    <Style Selector="suki|GlassCard">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="IsAnimated" Value="False" />
    </Style>
  </Application.Styles>
</Application>
