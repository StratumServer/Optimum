<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Optimum.Installer"
             x:Class="Optimum.Installer.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <!-- "Strata": the Optimum installer wears the game's own materials. Paper and
         ink, an oxidised-copper accent, moss and clay for status, and a basalt
         step rail down the left edge like a cut face of rock. -->
    <ResourceDictionary>
      <FontFamily x:Key="DisplayFont">avares://Optimum.Installer/Assets/Fonts/Spectral-SemiBold.ttf#Spectral</FontFamily>
      <FontFamily x:Key="MonoFont">Cascadia Code,Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace</FontFamily>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EFE7D6" />
          <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FBF7EE" />
          <SolidColorBrush x:Key="AppSurfaceSubtleBrush" Color="#E7DEC9" />
          <SolidColorBrush x:Key="AppBorderBrush" Color="#D3C6AB" />
          <SolidColorBrush x:Key="AppHairlineBrush" Color="#E0D5BD" />
          <SolidColorBrush x:Key="AppTextBrush" Color="#241F17" />
          <SolidColorBrush x:Key="AppMutedTextBrush" Color="#6C6252" />
          <SolidColorBrush x:Key="AppAccentBrush" Color="#A6552E" />
          <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#8C4522" />
          <SolidColorBrush x:Key="AppOnAccentBrush" Color="#FBF7EE" />
          <SolidColorBrush x:Key="AppSuccessBrush" Color="#4C5A2C" />
          <SolidColorBrush x:Key="AppSuccessSurfaceBrush" Color="#E1E4CC" />
          <SolidColorBrush x:Key="AppWarningBrush" Color="#875515" />
          <SolidColorBrush x:Key="AppWarningSurfaceBrush" Color="#F2E3C4" />
          <SolidColorBrush x:Key="AppDangerBrush" Color="#983A2A" />
          <SolidColorBrush x:Key="AppDangerSurfaceBrush" Color="#EFDCD1" />
          <SolidColorBrush x:Key="AppRailBrush" Color="#2C281E" />
          <SolidColorBrush x:Key="AppRailTextBrush" Color="#B7AA8E" />
          <SolidColorBrush x:Key="AppRailStepBrush" Color="#413A2B" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#A6552E" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#8C4522" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#8C4522" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#A6552E" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#8C4522" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#8C4522" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FBF7EE" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FBF7EE" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#A6552E" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#17140F" />
          <SolidColorBrush x:Key="AppSurfaceBrush" Color="#221E16" />
          <SolidColorBrush x:Key="AppSurfaceSubtleBrush" Color="#2C2619" />
          <SolidColorBrush x:Key="AppBorderBrush" Color="#42392A" />
          <SolidColorBrush x:Key="AppHairlineBrush" Color="#332C1F" />
          <SolidColorBrush x:Key="AppTextBrush" Color="#F1EBDC" />
          <SolidColorBrush x:Key="AppMutedTextBrush" Color="#A99D85" />
          <SolidColorBrush x:Key="AppAccentBrush" Color="#D68A5A" />
          <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#E8A177" />
          <SolidColorBrush x:Key="AppOnAccentBrush" Color="#1B1610" />
          <SolidColorBrush x:Key="AppSuccessBrush" Color="#A8BA79" />
          <SolidColorBrush x:Key="AppSuccessSurfaceBrush" Color="#2C331F" />
          <SolidColorBrush x:Key="AppWarningBrush" Color="#E0A860" />
          <SolidColorBrush x:Key="AppWarningSurfaceBrush" Color="#3B2E19" />
          <SolidColorBrush x:Key="AppDangerBrush" Color="#E38B77" />
          <SolidColorBrush x:Key="AppDangerSurfaceBrush" Color="#3B241E" />
          <SolidColorBrush x:Key="AppRailBrush" Color="#211C15" />
          <SolidColorBrush x:Key="AppRailTextBrush" Color="#8D8069" />
          <SolidColorBrush x:Key="AppRailStepBrush" Color="#332C20" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#D68A5A" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#E8A177" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#E8A177" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#D68A5A" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#E8A177" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#E8A177" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#1B1610" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#1B1610" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#D68A5A" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme />

    <!-- LineHeight lives on the wrapping copy, not the universal selector: a
         LineHeight below a face's natural line box (Spectral SemiBold's is
         ~1.52 em) makes Avalonia clip the descender and drop the top leading,
         which was pushing the page heading's "y" into the text below it. -->
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
      <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style Selector="TextBlock.display">
      <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
      <Setter Property="FontSize" Value="27" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LineHeight" Value="42" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.2" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.4" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.6" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="BoxShadow" Value="0 1 2 0 #14000000" />
    </Style>
    <Style Selector="Border.subtleCard">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="14" />
    </Style>

    <!-- Buttons: base is the secondary (outlined) tier; .accent is primary;
         .ghost is tertiary. Low corner radius throughout: cut, not moulded. -->
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.42" />
    </Style>

    <!-- No BorderThickness override here. The presenter already paints the
         border in the accent colour, so keeping 1 px is pixel-identical in
         appearance and keeps the content box the same height as the outlined
         tiers; a 0 px border shifted the accent label 1 px above the ghost
         button beside it in every footer. -->
    <Style Selector="Button.accent">
      <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
    </Style>
    <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource AppOnAccentBrush}" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentHoverBrush}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource AppOnAccentBrush}" />
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}" />
    </Style>

    <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource AppAccentBrush}" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="MinHeight" Value="30" />
    </Style>

    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtleBrush}" />
    </Style>
  </Application.Styles>
</Application>
