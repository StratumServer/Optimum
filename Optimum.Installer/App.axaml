<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:local="using:Optimum.Installer"
             x:Class="Optimum.Installer.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Lexend for all UI text (SukiUI reads DefaultFontFamily throughout its
           theme); JetBrains Mono inline for the log and command lines. -->
      <FontFamily x:Key="DefaultFontFamily">avares://Optimum.Installer/Assets/Fonts/Lexend/Lexend-VF.ttf#Lexend</FontFamily>
      <FontFamily x:Key="DisplayFont">avares://Optimum.Installer/Assets/Fonts/Lexend/Lexend-VF.ttf#Lexend</FontFamily>
      <FontFamily x:Key="MonoFont">avares://Optimum.Installer/Assets/Fonts/JetBrainsMono/JetBrainsMono-VF.ttf#JetBrains Mono</FontFamily>
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <suki:SukiTheme ThemeColor="Orange" />
  </Application.Styles>
</Application>
