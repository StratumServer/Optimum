<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:local="using:Optimum.Installer"
             x:Class="Optimum.Installer.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <!-- SukiUI reads DefaultFontFamily throughout its theme; the other two
           are used inline where a display or monospace face is wanted. -->
      <FontFamily x:Key="DefaultFontFamily">avares://Optimum.Installer/Assets/Fonts/Figtree/Figtree-VF.ttf#Figtree</FontFamily>
      <FontFamily x:Key="DisplayFont">avares://Optimum.Installer/Assets/Fonts/Fraunces/Fraunces.ttf#Fraunces</FontFamily>
      <FontFamily x:Key="MonoFont">avares://Optimum.Installer/Assets/Fonts/GeistMono/GeistMono-VF.ttf#Geist Mono</FontFamily>
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <suki:SukiTheme ThemeColor="Orange" />
  </Application.Styles>
</Application>
