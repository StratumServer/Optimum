<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:local="using:Optimum.Installer"
             x:Class="Optimum.Installer.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Lexend for all UI text (SukiUI reads DefaultFontFamily throughout its
           theme); JetBrains Mono inline for the log and command lines. -->
      <FontFamily x:Key="DefaultFontFamily">avares://Optimum.Installer/Assets/Fonts/Lexend/Lexend-VF.ttf#Lexend</FontFamily>
      <FontFamily x:Key="DisplayFont">avares://Optimum.Installer/Assets/Fonts/Lexend/Lexend-VF.ttf#Lexend</FontFamily>
      <FontFamily x:Key="MonoFont">avares://Optimum.Installer/Assets/Fonts/JetBrainsMono/JetBrainsMono-VF.ttf#JetBrains Mono</FontFamily>
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <suki:SukiTheme ThemeColor="Orange" />

    <!-- Accessibility on top of the SukiUI scale: body up to 15/1.5, headings
         a step larger, and secondary copy on a real 7:1 grey instead of
         SukiUI's near-#8a8a8a caption colour. -->
    <Style Selector="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="LineHeight" Value="22" />
    </Style>
    <Style Selector="SelectableTextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="LineHeight" Value="22" />
    </Style>
    <Style Selector="TextBlock.Caption">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
    </Style>
    <!-- Headings need their own line height: the 22 above would clip Lexend's
         caps at these sizes. -->
    <Style Selector="TextBlock.h5">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="LineHeight" Value="24" />
    </Style>
    <Style Selector="TextBlock.h3">
      <Setter Property="FontSize" Value="27" />
      <Setter Property="LineHeight" Value="34" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="32" />
      <Setter Property="LineHeight" Value="40" />
    </Style>
  </Application.Styles>
</Application>
