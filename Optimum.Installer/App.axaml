<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:local="using:Optimum.Installer"
             x:Class="Optimum.Installer.App"
             RequestedThemeVariant="Default">
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>
  <Application.Styles>
    <suki:SukiTheme ThemeColor="Orange" />

    <!-- A little tightening on top of SukiUI: the wizard is a dense form, so the
         cards do not need the default 20px radius or the hover animation. -->
    <Style Selector="suki|GlassCard">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="IsAnimated" Value="False" />
    </Style>
  </Application.Styles>
</Application>
